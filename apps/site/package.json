{
  "name": "@minnowdb/site",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "predev": "npm run build:packages && node scripts/vendor-engines.mjs && node scripts/generate-playground-types.mjs && node scripts/generate-llms.mjs",
    "prebuild": "npm run build:packages && node scripts/vendor-engines.mjs && node scripts/generate-playground-types.mjs && node scripts/generate-llms.mjs",
    "build:packages": "tsc -b ../../packages/core ../../packages/kysely ../../packages/react ../../packages/export ../../packages/devtools --force",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@minnowdb/core": ">=0.3.0 <1.0.0",
    "@minnowdb/devtools": ">=0.2.0 <1.0.0",
    "@minnowdb/kysely": ">=0.1.0 <1.0.0",
    "fumadocs-core": "^16.14.4",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-ui": "^16.14.4",
    "kysely": "^0.29.5",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "@electric-sql/pglite": "^0.5.5",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1"
  }
}
