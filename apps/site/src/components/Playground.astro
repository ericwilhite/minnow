---
/**
 * The docs playground: the real devtools panel, rendered in the flow of the page against a small
 * in-memory database. It is the same component an app embeds, in `inline` mode.
 */
---

<div class="playground">
  <div class="playground-mount" data-playground>
    <p class="playground-loading">Starting a database in your browser…</p>
  </div>
  <p class="playground-note">
    Everything here runs in this page against an in-memory database. Edit rows, run statements —
    nothing is saved, and a reload starts over.
  </p>
</div>

<style>
  .playground {
    margin: 1.5rem 0 2rem;
  }

  .playground-mount {
    min-height: 520px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .playground-loading {
    margin: 0;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .playground-note {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
</style>

<script>
  // The engine, the panel, and the editor all load only once a playground is actually on screen,
  // so a docs page that has one still renders without them.
  const mount = document.querySelector<HTMLElement>("[data-playground]");

  async function start(container: HTMLElement): Promise<void> {
    try {
      const [{ createPlaygroundDatabase, playgroundQuery }, { mountMinnowDevtools }] =
        await Promise.all([import("../lib/playground.ts"), import("@minnowdb/devtools")]);
      const database = await createPlaygroundDatabase();
      container.replaceChildren();
      mountMinnowDevtools(database, {
        container,
        mode: "inline",
        initialQuery: playgroundQuery,
        storageKey: "minnow-docs-playground",
      });
    } catch (error) {
      container.textContent = `The playground could not start: ${
        error instanceof Error ? error.message : String(error)
      }`;
    }
  }

  if (mount !== null) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.disconnect();
        void start(mount);
      }
    });
    observer.observe(mount);
  }
</script>
