---
/**
 * All charts and the table view for one captured browser run. SVG is generated at
 * build time from the results JSON — no client-side chart code.
 *
 * Colors follow the dataviz method: engines take categorical slots 1–3
 * (validated all-pairs in both modes); labels and axes wear ink tokens, never
 * series color. The light-mode aqua sits below 3:1 on the surface, so every
 * chart ships direct labels and a full table view (the relief rule).
 */
interface EngineRun {
  engine: string;
  supported: boolean;
  prepareMs?: number;
  medianMs?: number;
  p95Ms?: number;
  resultRows?: number;
  verified?: boolean;
  reason?: string;
}

interface SuiteQuery {
  id: string;
  name: string;
  complexity: string;
  sql: string;
  expectedRows: number;
  engines: EngineRun[];
}

export interface BenchResults {
  capturedAt: string;
  browser: { project: string; version: string; storage?: string };
  host: { model: string; cpus: number };
  config: { scale: number };
  dataset: {
    totalRows: number;
    tableRows: Record<string, number>;
    engines: Record<
      string,
      {
        status: string;
        version?: string;
        persistence?: string;
        storedBytes?: number;
        buildMs?: number;
        insertMs?: number;
      }
    >;
  };
  suite: {
    sampleCount: number;
    engines: string[];
    queries: SuiteQuery[];
    totalMsByEngine: Record<string, number>;
    passed: boolean;
  };
}

interface Props {
  results: BenchResults;
  paneId: string;
}

const { results, paneId } = Astro.props;

const ENGINE_META: Record<string, { label: string; slot: number }> = {
  minnow: { label: "Minnow", slot: 1 },
  sqlite: { label: "SQLite WASM", slot: 2 },
  pglite: { label: "PGlite", slot: 3 },
  duckdb: { label: "DuckDB (in-memory)", slot: 4 },
};
const engines = results.suite.engines;
const label = (engine: string): string => ENGINE_META[engine]?.label ?? engine;
const slot = (engine: string): number => ENGINE_META[engine]?.slot ?? 1;

const fmtMs = (ms: number): string =>
  ms >= 100 ? `${Math.round(ms).toLocaleString("en-US")} ms` : ms >= 1 ? `${ms.toFixed(1)} ms` : `${ms.toFixed(2)} ms`;
const fmtS = (ms: number): string => `${(ms / 1000).toFixed(1)} s`;
const fmtMB = (bytes: number): string => `${(bytes / (1024 * 1024)).toFixed(1)} MB`;

/* ---------- horizontal bar chart geometry ---------- */
const BAR_W = 860;
const BAR_LABEL_W = 130;
const BAR_VALUE_W = 84;
const BAR_H = 22;
const BAR_GAP = 12;

interface BarDatum {
  name: string;
  slot: number;
  value: number;
  valueLabel: string;
}

function barChart(data: BarDatum[]): {
  height: number;
  plotWidth: number;
  bars: (BarDatum & { y: number; width: number })[];
} {
  const plotWidth = BAR_W - BAR_LABEL_W - BAR_VALUE_W;
  const max = Math.max(...data.map((d) => d.value));
  return {
    height: data.length * (BAR_H + BAR_GAP) - BAR_GAP + 8,
    plotWidth,
    bars: data.map((d, i) => ({
      ...d,
      y: i * (BAR_H + BAR_GAP) + 4,
      width: Math.max(2, (d.value / max) * plotWidth),
    })),
  };
}

// Flat-left, 4px-rounded-right bar path anchored at the axis.
const barPath = (x: number, y: number, w: number, h: number): string => {
  const r = Math.min(4, w / 2);
  return `M${x} ${y} h${w - r} a${r} ${r} 0 0 1 ${r} ${r} v${h - 2 * r} a${r} ${r} 0 0 1 -${r} ${r} h${-(w - r)} Z`;
};

const totalBars = barChart(
  engines.map((engine) => ({
    name: label(engine),
    slot: slot(engine),
    value: results.suite.totalMsByEngine[engine] ?? 0,
    valueLabel: fmtMs(results.suite.totalMsByEngine[engine] ?? 0),
  })),
);

const buildBars = barChart(
  engines.map((engine) => ({
    name: label(engine),
    slot: slot(engine),
    value: results.dataset.engines[engine]?.buildMs ?? 0,
    valueLabel: fmtS(results.dataset.engines[engine]?.buildMs ?? 0),
  })),
);

const sizeBars = barChart(
  engines.map((engine) => ({
    name: label(engine),
    slot: slot(engine),
    value: results.dataset.engines[engine]?.storedBytes ?? 0,
    valueLabel: fmtMB(results.dataset.engines[engine]?.storedBytes ?? 0),
  })),
);

/* ---------- per-query dot plot (log scale) ---------- */
const DOT_W = 860;
const DOT_LABEL_W = 300;
const DOT_ROW_H = 30;
const DOT_TOP = 26;
const DOT_R = 5;
// Shared log domain across both browser panes so toggling compares like with like.
const LOG_MIN = 0.01;
const LOG_MAX = 200;
const dotPlotWidth = DOT_W - DOT_LABEL_W - 16;
const xLog = (ms: number): number =>
  DOT_LABEL_W +
  ((Math.log10(Math.min(Math.max(ms, LOG_MIN), LOG_MAX)) - Math.log10(LOG_MIN)) /
    (Math.log10(LOG_MAX) - Math.log10(LOG_MIN))) *
    dotPlotWidth;
const ticks = [0.01, 0.1, 1, 10, 100];
const tickLabel = (t: number): string => (t < 1 ? String(t) : `${t}`);

const complexityOrder = ["simple", "moderate", "complex"];
const queriesOrdered = complexityOrder.flatMap((complexity) =>
  results.suite.queries.filter((q) => q.complexity === complexity),
);
const dotRows = queriesOrdered.map((q, i) => ({
  query: q,
  y: DOT_TOP + i * DOT_ROW_H,
  groupStart:
    i === 0 || queriesOrdered[i - 1]?.complexity !== q.complexity ? q.complexity : undefined,
}));
const dotHeight = DOT_TOP + dotRows.length * DOT_ROW_H + 30;
const axisY = DOT_TOP + dotRows.length * DOT_ROW_H;
---

<section class="bench-pane" id={paneId}>
  <div class="chart-card">
    <h3>Full suite, total median time</h3>
    <p class="chart-sub">
      Sum of per-query medians across all {results.suite.queries.length} queries — lower is better.
    </p>
    <svg viewBox={`0 0 ${BAR_W} ${totalBars.height}`} role="img" aria-label="Total suite time by engine">
      {
        totalBars.bars.map((bar) => (
          <>
            <text class="row-label" x={BAR_LABEL_W - 10} y={bar.y + BAR_H / 2}>
              {bar.name}
            </text>
            <path d={barPath(BAR_LABEL_W, bar.y, bar.width, BAR_H)} class={`series-${bar.slot}`}>
              <title>{`${bar.name}: ${bar.valueLabel}`}</title>
            </path>
            <text class="value-label" x={BAR_LABEL_W + bar.width + 8} y={bar.y + BAR_H / 2}>
              {bar.valueLabel}
            </text>
          </>
        ))
      }
    </svg>
  </div>

  <div class="chart-row">
    <div class="chart-card half">
      <h3>Dataset build</h3>
      <p class="chart-sub">
        Ingesting all {results.dataset.totalRows.toLocaleString("en-US")} rows.
      </p>
      <svg viewBox={`0 0 ${BAR_W} ${buildBars.height}`} role="img" aria-label="Dataset build time by engine">
        {
          buildBars.bars.map((bar) => (
            <>
              <text class="row-label" x={BAR_LABEL_W - 10} y={bar.y + BAR_H / 2}>
                {bar.name}
              </text>
              <path d={barPath(BAR_LABEL_W, bar.y, bar.width, BAR_H)} class={`series-${bar.slot}`}>
                <title>{`${bar.name}: ${bar.valueLabel}`}</title>
              </path>
              <text class="value-label" x={BAR_LABEL_W + bar.width + 8} y={bar.y + BAR_H / 2}>
                {bar.valueLabel}
              </text>
            </>
          ))
        }
      </svg>
    </div>
    <div class="chart-card half">
      <h3>Stored size</h3>
      <p class="chart-sub">
        Each engine's own report of its stored bytes — Minnow's block ledger, SQLite's
        <code>page_count × page_size</code>, PGlite's <code>pg_database_size</code>. The dataset
        is deterministic, so these are identical across browsers by construction.
      </p>
      <svg viewBox={`0 0 ${BAR_W} ${sizeBars.height}`} role="img" aria-label="Stored size by engine">
        {
          sizeBars.bars.map((bar) => (
            <>
              <text class="row-label" x={BAR_LABEL_W - 10} y={bar.y + BAR_H / 2}>
                {bar.name}
              </text>
              <path d={barPath(BAR_LABEL_W, bar.y, bar.width, BAR_H)} class={`series-${bar.slot}`}>
                <title>{`${bar.name}: ${bar.valueLabel}`}</title>
              </path>
              <text class="value-label" x={BAR_LABEL_W + bar.width + 8} y={bar.y + BAR_H / 2}>
                {bar.valueLabel}
              </text>
            </>
          ))
        }
      </svg>
    </div>
  </div>

  <div class="chart-card">
    <h3>Per-query median latency</h3>
    <p class="chart-sub">
      Median of {results.suite.sampleCount} samples, log scale. Hover a dot for p95 and prepare
      time. Every result is checksum-verified identical across engines.
    </p>
    <div class="legend" role="list">
      {
        engines.map((engine) => (
          <span class="legend-item" role="listitem">
            <span class={`swatch series-bg-${slot(engine)}`}></span>
            {label(engine)}
          </span>
        ))
      }
    </div>
    <svg viewBox={`0 0 ${DOT_W} ${dotHeight}`} role="img" aria-label="Per-query median latency by engine, log scale">
      {ticks.map((t) => (
        <>
          <line class="grid" x1={xLog(t)} y1={DOT_TOP - 12} x2={xLog(t)} y2={axisY}></line>
          <text class="tick-label" x={xLog(t)} y={axisY + 18}>
            {tickLabel(t)}
          </text>
        </>
      ))}
      <text class="tick-label axis-unit" x={DOT_W - 8} y={axisY + 18}>
        ms
      </text>
      {
        dotRows.map(({ query, y, groupStart }) => (
          <>
            {groupStart !== undefined && (
              <text class="group-label" x={0} y={y + DOT_ROW_H / 2}>
                {groupStart}
              </text>
            )}
            <text class="row-label query-label" x={DOT_LABEL_W - 12} y={y + DOT_ROW_H / 2 - 4}>
              {query.name}
            </text>
            <line
              class="row-line"
              x1={DOT_LABEL_W}
              y1={y + DOT_ROW_H / 2 - 4}
              x2={DOT_W - 16}
              y2={y + DOT_ROW_H / 2 - 4}
            ></line>
            {query.engines
              .filter((run) => run.supported && run.medianMs !== undefined)
              .map((run) => (
                <circle
                  class={`dot series-${slot(run.engine)}`}
                  cx={xLog(run.medianMs ?? LOG_MIN)}
                  cy={y + DOT_ROW_H / 2 - 4}
                  r={DOT_R}
                >
                  <title>
                    {`${query.name} — ${label(run.engine)}\nmedian ${fmtMs(run.medianMs ?? 0)} · p95 ${fmtMs(
                      run.p95Ms ?? 0,
                    )} · prepare ${fmtMs(run.prepareMs ?? 0)}${run.verified === true ? "\nresult checksum verified" : ""}`}
                  </title>
                </circle>
              ))}
          </>
        ))
      }
    </svg>
  </div>

  <details class="bench-table">
    <summary>Table view — every number in the charts above</summary>
    <table>
      <thead>
        <tr>
          <th>Query</th>
          <th>Complexity</th>
          {engines.map((engine) => <th colspan="2">{label(engine)}</th>)}
        </tr>
        <tr>
          <th></th>
          <th></th>
          {
            engines.map(() => (
              <>
                <th>median</th>
                <th>p95</th>
              </>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          queriesOrdered.map((query) => (
            <tr>
              <td>{query.name}</td>
              <td>{query.complexity}</td>
              {engines.map((engine) => {
                const run = query.engines.find((r) => r.engine === engine);
                return run?.supported === true ? (
                  <>
                    <td class="num">{fmtMs(run.medianMs ?? 0)}</td>
                    <td class="num">{fmtMs(run.p95Ms ?? 0)}</td>
                  </>
                ) : (
                  <td colspan="2">not supported</td>
                );
              })}
            </tr>
          ))
        }
        <tr class="totals">
          <td>Total (sum of medians)</td>
          <td></td>
          {
            engines.map((engine) => (
              <td class="num" colspan="2">
                {fmtMs(results.suite.totalMsByEngine[engine] ?? 0)}
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </details>
</section>

<style>
  .bench-pane {
    display: grid;
    gap: 1.25rem;
  }

  .chart-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .chart-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--viz-surface);
    padding: 1.1rem 1.25rem 0.9rem;
    overflow-x: auto;
  }

  .chart-card h3 {
    font-size: 0.98rem;
    font-weight: 650;
    margin: 0 0 0.15rem;
  }

  .chart-sub {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin: 0 0 0.9rem;
  }

  svg {
    width: 100%;
    height: auto;
    min-width: 540px;
    display: block;
  }

  .series-1 {
    fill: var(--viz-series-1);
  }
  .series-2 {
    fill: var(--viz-series-2);
  }
  .series-3 {
    fill: var(--viz-series-3);
  }

  .series-4 {
    fill: var(--viz-series-4);
  }
  .series-bg-1 {
    background: var(--viz-series-1);
  }
  .series-bg-2 {
    background: var(--viz-series-2);
  }
  .series-bg-3 {
    background: var(--viz-series-3);
  }

  .series-bg-4 {
    background: var(--viz-series-4);
  }

  .dot {
    stroke: var(--viz-surface);
    stroke-width: 2;
  }

  .row-label {
    fill: var(--text);
    font-size: 13px;
    text-anchor: end;
    dominant-baseline: central;
  }

  .query-label {
    fill: var(--text-secondary);
    font-size: 12.5px;
  }

  .value-label {
    fill: var(--text-secondary);
    font-size: 12px;
    dominant-baseline: central;
    font-variant-numeric: tabular-nums;
  }

  .tick-label {
    fill: var(--viz-muted);
    font-size: 11px;
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }

  .axis-unit {
    text-anchor: end;
  }

  .group-label {
    fill: var(--viz-muted);
    font-size: 10.5px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .grid {
    stroke: var(--viz-grid);
    stroke-width: 1;
  }

  .row-line {
    stroke: var(--viz-grid);
    stroke-width: 1;
    stroke-dasharray: 1 3;
  }

  .legend {
    display: flex;
    gap: 1.1rem;
    margin-bottom: 0.6rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    display: inline-block;
  }

  .bench-table summary {
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--text-secondary);
    padding: 0.5rem 0;
  }

  .bench-table table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.82rem;
    margin-top: 0.5rem;
  }

  .bench-table th {
    text-align: left;
    font-weight: 600;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    padding: 0.35rem 0.7rem 0.35rem 0;
  }

  .bench-table td {
    border-bottom: 1px solid var(--border);
    padding: 0.35rem 0.7rem 0.35rem 0;
    vertical-align: top;
  }

  .bench-table td.num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .bench-table .totals td {
    font-weight: 650;
  }
</style>
