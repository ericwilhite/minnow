---
/**
 * All charts and the table view for one captured browser run. SVG is generated at
 * build time from the results JSON — no client-side chart code.
 *
 * Colors follow the dataviz method: engines take categorical slots 1–3
 * (validated all-pairs in both modes); labels and axes wear ink tokens, never
 * series color. The light-mode aqua sits below 3:1 on the surface, so every
 * chart ships direct labels and a full table view (the relief rule).
 */
interface EngineRun {
  engine: string;
  supported: boolean;
  prepareMs?: number;
  medianMs?: number;
  /** Engines with a result cache: what a repeat costs with that cache left on (the default). */
  cachedMedianMs?: number;
  /** Peak modeled execution memory, self-reported by engines that measure their own execution. */
  peakMemoryBytes?: number;
  p95Ms?: number;
  resultRows?: number;
  verified?: boolean;
  reason?: string;
}

interface WriteRun {
  engine: string;
  supported: boolean;
  medianMs?: number;
  rowsPerSecond?: number;
  verified?: boolean;
  error?: string;
}

interface WriteCase {
  id: string;
  name: string;
  operation: string;
  workload: WorkloadKind;
  rows: number;
  engines: WriteRun[];
}

type WorkloadKind = "oltp" | "olap";

interface SuiteQuery {
  workload: WorkloadKind;
  id: string;
  name: string;
  complexity: string;
  sql: string;
  expectedRows: number;
  engines: EngineRun[];
}

export interface BenchResults {
  schemaVersion: 1;
  kind: "engine-comparison";
  capturedAt: string;
  browser: { project: string; version: string; storage?: string };
  host: { model: string; cpus: number };
  config: { scale: number; engines: string[] };
  dataset: {
    totalRows: number;
    tableRows: Record<string, number>;
    engines: Record<
      string,
      {
        status: string;
        version?: string;
        persistence?: string;
        storedBytes?: number;
        buildMs?: number;
        insertMs?: number;
      }
    >;
  };
  reads: {
    sampleCount: number;
    engines: string[];
    queries: SuiteQuery[];
    totalMsByEngine: Record<string, number>;
    passed: boolean;
  };
  writes: {
    sampleCount: number;
    engines: string[];
    cases: WriteCase[];
    passed: boolean;
  };
}

interface Props {
  results: BenchResults;
  paneId: string;
}

const { results, paneId } = Astro.props;

const ENGINE_META: Record<string, { label: string; slot: number }> = {
  minnow: { label: "Minnow", slot: 1 },
  sqlite: { label: "SQLite WASM", slot: 2 },
  pglite: { label: "PGlite", slot: 3 },
};
const engines = results.reads.engines;
const label = (engine: string): string => ENGINE_META[engine]?.label ?? engine;
const slot = (engine: string): number => ENGINE_META[engine]?.slot ?? 1;

const fmtMs = (ms: number): string =>
  ms >= 100 ? `${Math.round(ms).toLocaleString("en-US")} ms` : ms >= 1 ? `${ms.toFixed(1)} ms` : `${ms.toFixed(2)} ms`;
const fmtS = (ms: number): string => `${(ms / 1000).toFixed(1)} s`;
const fmtMB = (bytes: number): string => `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
/** Execution memory is kilobytes to a few megabytes; pick the unit per value so both read. */
const fmtBytes = (bytes: number): string =>
  bytes >= 1024 * 1024
    ? `${(bytes / (1024 * 1024)).toFixed(1)} MB`
    : `${(bytes / 1024).toFixed(0)} KB`;

/* ---------- horizontal bar chart geometry ---------- */
const BAR_W = 640;
const BAR_LABEL_W = 160;
const BAR_VALUE_W = 92;
const BAR_H = 28;
const BAR_GAP = 14;

interface BarDatum {
  name: string;
  slot: number;
  value: number;
  valueLabel: string;
}

function barChart(data: BarDatum[]): {
  height: number;
  plotWidth: number;
  bars: (BarDatum & { y: number; width: number })[];
} {
  const plotWidth = BAR_W - BAR_LABEL_W - BAR_VALUE_W;
  const max = Math.max(...data.map((d) => d.value));
  return {
    height: data.length * (BAR_H + BAR_GAP) - BAR_GAP + 8,
    plotWidth,
    bars: data.map((d, i) => ({
      ...d,
      y: i * (BAR_H + BAR_GAP) + 4,
      width: Math.max(2, (d.value / max) * plotWidth),
    })),
  };
}

// Flat-left, 4px-rounded-right bar path anchored at the axis.
const barPath = (x: number, y: number, w: number, h: number): string => {
  const r = Math.min(4, w / 2);
  return `M${x} ${y} h${w - r} a${r} ${r} 0 0 1 ${r} ${r} v${h - 2 * r} a${r} ${r} 0 0 1 -${r} ${r} h${-(w - r)} Z`;
};

/**
 * Geometric mean, not the sum. These 16 queries span three orders of magnitude, so a sum is
 * just the slowest few — one 33 ms cohort analysis outweighs ten 0.5 ms lookups, and an engine
 * could lose every fast query and still "win" the total. The geometric mean gives each query
 * the same weight whatever its absolute cost, which is why heterogeneous suites use it.
 */
const geomean = (values: number[]): number => {
  const usable = values.filter((value) => value > 0);
  if (usable.length === 0) return 0;
  return Math.exp(usable.reduce((sum, value) => sum + Math.log(value), 0) / usable.length);
};

const medians = (engine: string, workload?: WorkloadKind): number[] =>
  results.reads.queries
    .filter((query) => workload === undefined || query.workload === workload)
    .map((query) => query.engines.find((run) => run.engine === engine))
    .filter((run) => run?.supported === true)
    .map((run) => run?.medianMs ?? 0);

const cachedMedians = (workload?: WorkloadKind): number[] =>
  results.reads.queries
    .filter((query) => workload === undefined || query.workload === workload)
    .map((query) => query.engines.find((run) => run.engine === "minnow"))
    .filter((run) => run?.supported === true && run.cachedMedianMs !== undefined)
    .map((run) => run?.cachedMedianMs ?? 0);

/** Minnow appears twice: what a query costs to run, and what a repeat costs from its cache. */
type SummaryRow = { name: string; slot: number; value: number };
const summaryRows = (workload?: WorkloadKind): SummaryRow[] => {
  const rows: SummaryRow[] = [];
  for (const engine of engines) {
    rows.push({ name: label(engine), slot: slot(engine), value: geomean(medians(engine, workload)) });
    if (engine === "minnow") {
      const cached = geomean(cachedMedians(workload));
      if (cached > 0) {
        rows.push({ name: "Minnow (cached repeat)", slot: slot(engine), value: cached });
      }
    }
  }
  return rows;
};

const workloads: readonly WorkloadKind[] = ["oltp", "olap"];
const workloadLabels: Record<WorkloadKind, string> = { oltp: "OLTP", olap: "OLAP" };
const workloadDescriptions: Record<WorkloadKind, { read: string; write: string }> = {
  oltp: {
    read: "Selective key, set, and bounded-range lookups. Lower latency is better.",
    write: "Point and small-batch inserts, updates, and upserts (1–100 rows).",
  },
  olap: {
    read: "Scans, joins, windows, and aggregates. Lower execution time is better.",
    write: "Bulk ingestion and mutation batches (10,000–100,000 rows).",
  },
};
const readCounts = Object.fromEntries(
  workloads.map((workload) => [
    workload,
    results.reads.queries.filter((query) => query.workload === workload).length,
  ]),
) as Record<WorkloadKind, number>;
const readBars = Object.fromEntries(
  workloads.map((workload) => [
    workload,
    barChart(
      summaryRows(workload).map((row) => ({
        name: row.name,
        slot: row.slot,
        value: row.value,
        valueLabel: fmtMs(row.value),
      })),
    ),
  ]),
) as Record<WorkloadKind, ReturnType<typeof barChart>>;
const writeCasesOrdered = workloads.flatMap((workload) =>
  (results.writes?.cases ?? []).filter((entry) => entry.workload === workload),
);

const buildBars = barChart(
  engines.map((engine) => ({
    name: label(engine),
    slot: slot(engine),
    value: results.dataset.engines[engine]?.buildMs ?? 0,
    valueLabel: fmtS(results.dataset.engines[engine]?.buildMs ?? 0),
  })),
);

// Engines with no stored bytes to report are omitted rather than drawn as a misleading
// zero-length bar.
const sizeBars = barChart(
  engines
    .filter((engine) => (results.dataset.engines[engine]?.storedBytes ?? null) !== null)
    .map((engine) => ({
      name: label(engine),
      slot: slot(engine),
      value: results.dataset.engines[engine]?.storedBytes ?? 0,
      valueLabel: fmtMB(results.dataset.engines[engine]?.storedBytes ?? 0),
    })),
);

/* ---------- per-query dot plot (log scale) ---------- */
const DOT_W = 1_040;
const DOT_LABEL_W = 330;
const DOT_ROW_H = 36;
const DOT_TOP = 30;
const DOT_R = 6.5;
// Shared log domain across both browser panes so toggling compares like with like.
const LOG_MIN = 0.01;
const LOG_MAX = 200;
const dotPlotWidth = DOT_W - DOT_LABEL_W - 16;
const xLog = (ms: number): number =>
  DOT_LABEL_W +
  ((Math.log10(Math.min(Math.max(ms, LOG_MIN), LOG_MAX)) - Math.log10(LOG_MIN)) /
    (Math.log10(LOG_MAX) - Math.log10(LOG_MIN))) *
    dotPlotWidth;
const ticks = [0.01, 0.1, 1, 10, 100];
const tickLabel = (t: number): string => (t < 1 ? String(t) : `${t}`);

const complexityOrder = ["simple", "moderate", "complex"];
const queriesOrdered = workloads.flatMap((workload) =>
  complexityOrder.flatMap((complexity) =>
    results.reads.queries.filter(
      (query) => query.workload === workload && query.complexity === complexity,
    ),
  ),
);
const dotRows = queriesOrdered.map((q, i) => ({
  query: q,
  y: DOT_TOP + i * DOT_ROW_H,
  groupStart:
    i === 0 || queriesOrdered[i - 1]?.workload !== q.workload
      ? `${workloadLabels[q.workload]} read`
      : undefined,
}));
const dotHeight = DOT_TOP + dotRows.length * DOT_ROW_H + 30;
const axisY = DOT_TOP + dotRows.length * DOT_ROW_H;
---

<section class="bench-pane" id={paneId}>
  <div class="section-heading">
    <p class="eyebrow">Read workloads</p>
    <h2>Latency and query execution</h2>
    <p>
      OLTP and OLAP are reported separately so selective lookup latency never disappears inside
      scan-heavy analytical totals.
    </p>
  </div>

  <div class="chart-row read-summary">
    {
      workloads.map((workload) => {
        const bars = readBars[workload];
        return (
          <div class="chart-card half">
            <h3>{workloadLabels[workload]} reads · {readCounts[workload]} queries</h3>
            <p class="chart-sub">
              {workloadDescriptions[workload].read} Geometric mean of per-query medians; every
              query carries equal weight.
            </p>
            <svg class="bar-chart" viewBox={`0 0 ${BAR_W} ${bars.height}`} role="img" aria-label={`${workloadLabels[workload]} read time by engine`}>
              {bars.bars.map((bar) => (
                <>
                  <text class="row-label" x={BAR_LABEL_W - 10} y={bar.y + BAR_H / 2}>
                    {bar.name}
                  </text>
                  <path d={barPath(BAR_LABEL_W, bar.y, bar.width, BAR_H)} class={`series-${bar.slot}`}>
                    <title>{`${bar.name}: ${bar.valueLabel}`}</title>
                  </path>
                  <text class="value-label" x={BAR_LABEL_W + bar.width + 8} y={bar.y + BAR_H / 2}>
                    {bar.valueLabel}
                  </text>
                </>
              ))}
            </svg>
          </div>
        );
      })
    }
  </div>

  {
    results.writes !== undefined && results.writes.cases.length > 0 && (
      <>
        <div class="section-heading">
          <p class="eyebrow">Write workloads</p>
          <h2>Transactional mutations and bulk ingestion</h2>
          <p>
            OLTP covers 1–100 row operations; OLAP covers 10,000–100,000 row batches. Throughput
            is higher-is-better, and the latency for each batch remains visible underneath.
          </p>
        </div>
        <div class="chart-card">
          <p class="chart-sub">
            Every sample gets a new table, and every final table is checked row-for-row against an
            independent JavaScript oracle before its timing is accepted.
          </p>
          <table class="split-table">
            <thead>
              <tr>
                <th>Workload</th>
                <th>Operation</th>
                <th class="num">Rows</th>
                {results.writes.engines.map((engine) => (
                  <th class="num engine-start">{label(engine)}</th>
                ))}
              </tr>
            </thead>
            <tbody>
            {writeCasesOrdered.map((entry, index) => {
              const best = Math.max(
                ...entry.engines
                  .filter((run) => run.supported && typeof run.rowsPerSecond === "number")
                  .map((run) => run.rowsPerSecond ?? 0),
              );
              return (
                <tr class={index > 0 && writeCasesOrdered[index - 1]?.workload !== entry.workload ? "workload-start" : undefined}>
                  <td><strong>{workloadLabels[entry.workload]}</strong></td>
                  <td>{entry.name}</td>
                  <td class="num">{entry.rows.toLocaleString("en-US")}</td>
                  {results.writes?.engines.map((engine) => {
                    const run = entry.engines.find((candidate) => candidate.engine === engine);
                    if (run?.supported !== true) {
                      return (
                        <td class="num engine-start" title={run?.error ?? "not supported"}>
                          —
                        </td>
                      );
                    }
                    const isBest = (run.rowsPerSecond ?? 0) === best && best > 0;
                    return (
                      <td class={isBest ? "num best engine-start" : "num engine-start"}>
                        {isBest && <span class="best-mark">●</span>}
                        {Math.round(run.rowsPerSecond ?? 0).toLocaleString("en-US")}/s
                        <br />
                        <small class="cached">{fmtMs(run.medianMs ?? 0)}</small>
                      </td>
                    );
                  })}
                </tr>
              );
            })}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <div class="section-heading">
    <p class="eyebrow">Dataset</p>
    <h2>Build time and stored size</h2>
    <p>The same deterministic commerce dataset is materialized independently in every engine.</p>
  </div>

  <div class="chart-row">
    <div class="chart-card half">
      <h3>Dataset build</h3>
      <p class="chart-sub">
        Ingesting all {results.dataset.totalRows.toLocaleString("en-US")} rows.
      </p>
      <svg class="bar-chart" viewBox={`0 0 ${BAR_W} ${buildBars.height}`} role="img" aria-label="Dataset build time by engine">
        {
          buildBars.bars.map((bar) => (
            <>
              <text class="row-label" x={BAR_LABEL_W - 10} y={bar.y + BAR_H / 2}>
                {bar.name}
              </text>
              <path d={barPath(BAR_LABEL_W, bar.y, bar.width, BAR_H)} class={`series-${bar.slot}`}>
                <title>{`${bar.name}: ${bar.valueLabel}`}</title>
              </path>
              <text class="value-label" x={BAR_LABEL_W + bar.width + 8} y={bar.y + BAR_H / 2}>
                {bar.valueLabel}
              </text>
            </>
          ))
        }
      </svg>
    </div>
    <div class="chart-card half">
      <h3>Stored size</h3>
      <p class="chart-sub">
        Each engine's own report of its stored bytes — Minnow's block ledger, SQLite's{" "}
        <code>page_count × page_size</code>, PGlite's <code>pg_database_size</code>. The dataset
        is deterministic, so these are identical across browsers by construction.
      </p>
      <svg class="bar-chart" viewBox={`0 0 ${BAR_W} ${sizeBars.height}`} role="img" aria-label="Stored size by engine">
        {
          sizeBars.bars.map((bar) => (
            <>
              <text class="row-label" x={BAR_LABEL_W - 10} y={bar.y + BAR_H / 2}>
                {bar.name}
              </text>
              <path d={barPath(BAR_LABEL_W, bar.y, bar.width, BAR_H)} class={`series-${bar.slot}`}>
                <title>{`${bar.name}: ${bar.valueLabel}`}</title>
              </path>
              <text class="value-label" x={BAR_LABEL_W + bar.width + 8} y={bar.y + BAR_H / 2}>
                {bar.valueLabel}
              </text>
            </>
          ))
        }
      </svg>
    </div>
  </div>

  <div class="section-heading">
    <p class="eyebrow">Read details</p>
    <h2>Every measured query</h2>
  </div>

  <div class="chart-card">
    <h3>Per-query median latency</h3>
    <p class="chart-sub">
      Median of {results.reads.sampleCount} samples, log scale. Hover a dot for p95 and prepare
      time. Every result is checksum-verified identical across engines.
    </p>
    <div class="legend" role="list">
      {
        engines.map((engine) => (
          <span class="legend-item" role="listitem">
            <span class={`swatch series-bg-${slot(engine)}`}></span>
            {label(engine)}
          </span>
        ))
      }
    </div>
    <svg class="detail-chart" viewBox={`0 0 ${DOT_W} ${dotHeight}`} role="img" aria-label="Per-query median latency by engine, log scale">
      {ticks.map((t) => (
        <>
          <line class="grid" x1={xLog(t)} y1={DOT_TOP - 12} x2={xLog(t)} y2={axisY}></line>
          <text class="tick-label" x={xLog(t)} y={axisY + 18}>
            {tickLabel(t)}
          </text>
        </>
      ))}
      <text class="tick-label axis-unit" x={DOT_W - 8} y={axisY + 18}>
        ms
      </text>
      {
        dotRows.map(({ query, y, groupStart }) => (
          <>
            {groupStart !== undefined && (
              <text class="group-label" x={0} y={y + DOT_ROW_H / 2}>
                {groupStart}
              </text>
            )}
            <text class="row-label query-label" x={DOT_LABEL_W - 12} y={y + DOT_ROW_H / 2 - 4}>
              {query.name}
            </text>
            <line
              class="row-line"
              x1={DOT_LABEL_W}
              y1={y + DOT_ROW_H / 2 - 4}
              x2={DOT_W - 16}
              y2={y + DOT_ROW_H / 2 - 4}
            ></line>
            {query.engines
              .filter((run) => run.supported && run.medianMs !== undefined)
              .map((run) => (
                <circle
                  class={`dot series-${slot(run.engine)}`}
                  cx={xLog(run.medianMs ?? LOG_MIN)}
                  cy={y + DOT_ROW_H / 2 - 4}
                  r={DOT_R}
                >
                  <title>
                    {`${query.name} — ${label(run.engine)}\nmedian ${fmtMs(run.medianMs ?? 0)} · p95 ${fmtMs(
                      run.p95Ms ?? 0,
                    )} · prepare ${fmtMs(run.prepareMs ?? 0)}${run.verified === true ? "\nresult checksum verified" : ""}`}
                  </title>
                </circle>
              ))}
          </>
        ))
      }
    </svg>
  </div>

  <details class="bench-table" open>
    <summary>Every number in the charts above</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Query</th>
            <th>Workload</th>
            <th>Complexity</th>
            {engines.map((engine) => <th class="engine-group" colspan="2">{label(engine)}</th>)}
          </tr>
          <tr>
            <th></th>
            <th></th>
            <th></th>
            {
              engines.map(() => (
                <>
                  <th class="num engine-start">median</th>
                  <th class="num">p95</th>
                </>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            queriesOrdered.map((query, index) => (
              <tr class={index > 0 && queriesOrdered[index - 1]?.workload !== query.workload ? "workload-start" : undefined}>
                <td>{query.name}</td>
                <td>{workloadLabels[query.workload]}</td>
                <td>{query.complexity}</td>
                {engines.map((engine) => {
                  const run = query.engines.find((r) => r.engine === engine);
                  // Best in this row: the lowest median among engines that ran it. Marked so a
                  // reader can see who wins each query without comparing sixteen numbers by eye.
                  const best = Math.min(
                    ...query.engines
                      .filter((r) => r.supported && typeof r.medianMs === "number")
                      .map((r) => r.medianMs ?? Number.POSITIVE_INFINITY),
                  );
                  const isBest =
                    run?.supported === true &&
                    typeof run.medianMs === "number" &&
                    run.medianMs === best;
                  return run?.supported === true ? (
                    <>
                      <td class={isBest ? "num best engine-start" : "num engine-start"}>
                        {isBest && <span class="best-mark" title="Fastest engine for this query">●</span>}
                        {fmtMs(run.medianMs ?? 0)}
                        {run.cachedMedianMs !== undefined && (
                          <>
                            <br />
                            <small class="cached" title="Same statement with the result memo left on — the default an application gets. A cache lookup, not execution.">
                              {fmtMs(run.cachedMedianMs)} cached
                            </small>
                          </>
                        )}
                        {run.peakMemoryBytes !== undefined && (
                          <>
                            <br />
                            <small class="cached" title="Peak modeled execution memory this engine reserved for the statement. Self-reported: the browser exposes no cross-engine memory API here.">
                              {fmtBytes(run.peakMemoryBytes)} peak
                            </small>
                          </>
                        )}
                      </td>
                      <td class="num">{fmtMs(run.p95Ms ?? 0)}</td>
                    </>
                  ) : (
                    <td class="engine-start" colspan="2">not supported</td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</section>

<style>
  .bench-pane {
    display: grid;
    gap: 1.25rem;
  }

  .chart-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 760px) {
    .chart-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .section-heading {
    margin-top: 1.25rem;
  }

  .section-heading h2 {
    font-size: 1.35rem;
    margin: 0.1rem 0 0.25rem;
  }

  .section-heading p:not(.eyebrow) {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
    max-width: 48rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  .chart-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--viz-surface);
    padding: 1.3rem 1.4rem 1.1rem;
    overflow-x: auto;
  }

  .chart-card h3 {
    font-size: 1.05rem;
    font-weight: 650;
    margin: 0 0 0.15rem;
  }

  .chart-sub {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin: 0 0 0.9rem;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .bar-chart {
    min-width: 520px;
  }

  .detail-chart {
    min-width: 780px;
  }

  .series-1 {
    fill: var(--viz-series-1);
  }
  .series-2 {
    fill: var(--viz-series-2);
  }
  .series-3 {
    fill: var(--viz-series-3);
  }

  .series-bg-1 {
    background: var(--viz-series-1);
  }
  .series-bg-2 {
    background: var(--viz-series-2);
  }
  .series-bg-3 {
    background: var(--viz-series-3);
  }


  .dot {
    stroke: var(--viz-surface);
    stroke-width: 2;
  }

  .row-label {
    fill: var(--text);
    font-size: 14px;
    text-anchor: end;
    dominant-baseline: central;
  }

  .query-label {
    fill: var(--text-secondary);
    font-size: 14px;
  }

