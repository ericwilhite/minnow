---
/**
 * The minnow — an SVG descendant of the ASCII original: ><(((('>
 * Tail wags, body bobs; both stop under prefers-reduced-motion.
 *
 * With `water`, the fish swims at a waterline: drifting waves in front of and
 * behind it, bubbles rising, and droplets thrown off the tail. The extra depth
 * is added below the fish (viewBox stays anchored at 0 0), so the glyph itself
 * is drawn at exactly the same scale either way.
 */
interface Props {
  size?: number;
  swim?: boolean;
  water?: boolean;
}
const { size = 28, swim = true, water = false } = Astro.props;

const vbHeight = water ? 56 : 40;

/** A seamless wave: one 16-unit period repeated well past both edges, so a
 *  16-unit horizontal drift loops invisibly. `dir` flips the leading crest. */
const wave = (y: number, amp: number, dir: 1 | -1) =>
  `M-40 ${y} q4 ${dir * amp} 8 0 ${"t8 0 ".repeat(19).trim()} L120 70 L-40 70 Z`;

const bubbles = [
  { cx: 21, cy: 50, r: 1.5, delay: "0s" },
  { cx: 35, cy: 54, r: 1.1, delay: "1.4s" },
  { cx: 47, cy: 49, r: 1.7, delay: "2.6s" },
  { cx: 58, cy: 55, r: 1.2, delay: "3.7s" },
];

/** Droplets kicked up by the tail: [x, y, radius, flight vector, delay]. */
const droplets = [
  { cx: 12, cy: 26, r: 1.5, dx: -7, dy: -13, delay: "0s" },
  { cx: 17, cy: 27, r: 1.1, dx: -2, dy: -16, delay: "0.16s" },
  { cx: 22, cy: 27.5, r: 1.3, dx: 5, dy: -11, delay: "0.32s" },
  { cx: 8, cy: 25, r: 0.9, dx: -10, dy: -7, delay: "0.5s" },
];
---

<svg
  class:list={["minnow-logo", { swim, water }]}
  width={size * 1.8}
  height={(size * vbHeight) / 40}
  viewBox={`0 0 72 ${vbHeight}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    water && (
      <defs>
        <clipPath id="minnow-water-clip">
          <rect x="0" y="0" width="72" height="56" rx="3" />
        </clipPath>
      </defs>
    )
  }

  {
    water && (
      <g class="water-back" clip-path="url(#minnow-water-clip)">
        <g class="wave wave-back">
          <path d={wave(28.5, -3, -1)} />
        </g>
        <g class="bubbles">
          {bubbles.map((b) => (
            <circle cx={b.cx} cy={b.cy} r={b.r} style={`animation-delay:${b.delay}`} />
          ))}
        </g>
      </g>
    )
  }

  <g class="fish" fill="currentColor">
    <g class="tail">
      <path d="M28 20 L10 9.5 C14.2 16.4 14.2 23.6 10 30.5 Z"></path>
    </g>
    <path class="fin" d="M43 10.5 L47.5 4.5 L52.5 10.9 Z"></path>
    <path
      class="body"
      d="M27 20 C30.5 11.5 41 8.2 51 10.8 C58.5 12.8 64 16.4 66.5 20 C64 23.6 58.5 27.2 51 29.2 C41 31.8 30.5 28.5 27 20 Z"
    ></path>
    <g class="scales" stroke="var(--bg, #fff)" stroke-width="1.4" stroke-linecap="round" opacity="0.55">
      <path d="M38 13.4 C34.8 17.6 34.8 22.4 38 26.6"></path>
      <path d="M44.5 12.2 C41 17 41 23 44.5 27.8"></path>
      <path d="M51 11.6 C47.4 16.8 47.4 23.2 51 28.4"></path>
    </g>
    <circle class="eye" cx="58.6" cy="17.6" r="1.9" fill="var(--bg, #fff)"></circle>
  </g>

  {
    water && (
      <g class="water-front" clip-path="url(#minnow-water-clip)">
        <g class="splash">
          {droplets.map((d) => (
            <circle
              cx={d.cx}
              cy={d.cy}
              r={d.r}
              style={`--dx:${d.dx}px; --dy:${d.dy}px; animation-delay:${d.delay}`}
            />
          ))}
        </g>
        <g class="ripples" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
          <g transform="translate(15 29)">
            <path class="ripple" d="M-8 0 q8 -3 16 0" />
          </g>
          <g transform="translate(15 29)">
            <path class="ripple" d="M-8 0 q8 -3 16 0" style="animation-delay:1.1s" />
          </g>
        </g>
        <g class="wave wave-front">
          <path d={wave(30, 2.4, 1)} />
        </g>
      </g>
    )
  }
</svg>

<style>
  .minnow-logo {
    display: inline-block;
    vertical-align: middle;
    overflow: visible;
  }

  .swim .fish {
    animation: minnow-bob 3.6s ease-in-out infinite;
  }

  .swim .tail {
    transform-origin: 27px 20px;
    animation: minnow-wag 0.85s ease-in-out infinite alternate;
  }

  @keyframes minnow-wag {
    from {
      transform: rotate(10deg);
    }
    to {
      transform: rotate(-10deg);
    }
  }

  @keyframes minnow-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    30% {
      transform: translateY(-1.6px) rotate(-1.2deg);
    }
    65% {
      transform: translateY(1.1px) rotate(0.8deg);
    }
  }

  /* --- water ------------------------------------------------------------- */

  .wave path {
    fill: var(--accent, #2383e2);
  }

  .wave-back {
    opacity: 0.16;
    animation: minnow-drift 7s linear infinite;
  }

  .wave-front {
    opacity: 0.3;
    animation: minnow-drift 4.4s linear infinite reverse;
  }

  /* One full period of the wave, so the loop is seamless. */
  @keyframes minnow-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-16px);
    }
  }

  .bubbles circle {
    fill: var(--accent, #2383e2);
    opacity: 0;
    animation: minnow-bubble 5.2s ease-in infinite;
  }

  @keyframes minnow-bubble {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }
    12% {
      opacity: 0.5;
    }
    70% {
      opacity: 0.35;
    }
    100% {
      transform: translateY(-24px) translateX(2px);
      opacity: 0;
    }
  }

  .splash circle {
    fill: var(--accent, #2383e2);
    opacity: 0;
    animation: minnow-droplet 1.7s cubic-bezier(0.25, 0.6, 0.5, 1) infinite;
  }

  @keyframes minnow-droplet {
    0% {
      transform: translate(0, 0) scale(0.5);
      opacity: 0;
    }
    15% {
      opacity: 0.75;
    }
    55% {
      transform: translate(calc(var(--dx) * 0.75), var(--dy)) scale(1);
      opacity: 0.6;
    }
    100% {
      transform: translate(var(--dx), -2px) scale(0.6);
      opacity: 0;
    }
  }

  .ripple {
    color: var(--accent, #2383e2);
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: minnow-ripple 2.2s ease-out infinite;
  }

  @keyframes minnow-ripple {
    0% {
      transform: scale(0.35);
      opacity: 0;
    }
    25% {
      opacity: 0.45;
    }
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .swim .fish,
    .swim .tail,
    .wave-back,
    .wave-front {
      animation: none;
    }

    .bubbles,
    .splash,
    .ripples {
      display: none;
    }
  }
</style>
