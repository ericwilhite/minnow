---
import Base from "../layouts/Base.astro";
import BenchBrowser, { type BenchResults } from "../components/BenchBrowser.astro";

// Pick the newest engine-comparison capture per browser, decided by the recorded
// capturedAt timestamp rather than filename order. The site is the only home for
// benchmark results; captures land in src/data/benchmarks/.
const resultModules = import.meta.glob<{ default: BenchResults }>(
  "../data/benchmarks/*engine-comparison*.json",
  { eager: true },
);
const byBrowser = new Map<string, { path: string; results: BenchResults }>();
for (const [path, module] of Object.entries(resultModules)) {
  const results = module.default;
  const current = byBrowser.get(results.browser.project);
  if (current === undefined || results.capturedAt > current.results.capturedAt) {
    byBrowser.set(results.browser.project, { path, results });
  }
}
const panes = [...byBrowser.values()].map(({ results }) => ({
  results,
  project: results.browser.project,
  label: results.browser.project.charAt(0).toUpperCase() + results.browser.project.slice(1),
}));
const first = panes[0]?.results;
if (first === undefined) throw new Error("No engine-comparison results found");
const capturedDate = first.capturedAt.slice(0, 10);
const tableCount = Object.keys(first.dataset.tableRows).length;
const engineMeta = Object.entries(first.dataset.engines);
// Engines whose materialization records an in-memory (non-disk) store; the disclosure below
// is generated from this metadata so the page and the capture record cannot disagree.
const memoryEngines = engineMeta.filter(([, meta]) => meta.persistence.includes("in-memory"));
const engineLabels: Record<string, string> = {
  minnow: "Minnow",
  sqlite: "SQLite WASM",
  pglite: "PGlite",
  duckdb: "DuckDB",
};
---

<Base
  title="Benchmarks · Minnow"
  description="Minnow measured against SQLite WASM and PGlite in real browsers, with published methodology."
>
  <main class="bench">
    <header class="bench-header">
      <h1>Benchmarks</h1>
      <p class="lede">
        {engineMeta.map(([engine]) => engineLabels[engine] ?? engine).join(", ")} loading and
        querying the same {first.dataset.totalRows.toLocaleString("en-US")}-row commerce dataset
        in real browsers. Every query result is checksum-verified identical across all engines
        before any timing counts.
      </p>
    </header>

    <div class="stats" role="list">
      <div class="stat" role="listitem">
        <div class="stat-value">
          {
            first.dataset.totalRows >= 1_000_000
              ? `${(first.dataset.totalRows / 1_000_000).toFixed(1)}M`
              : `${(first.dataset.totalRows / 1000).toFixed(0)}k`
          }
        </div>
        <div class="stat-label">rows across {tableCount} tables</div>
      </div>
      <div class="stat" role="listitem">
        <div class="stat-value">{first.suite.queries.length}</div>
        <div class="stat-label">reference queries, point lookups to cohort analyses</div>
      </div>
      <div class="stat" role="listitem">
        <div class="stat-value">{first.suite.sampleCount}</div>
        <div class="stat-label">samples per query; medians reported</div>
      </div>
      <div class="stat" role="listitem">
        <div class="stat-value">{panes.length}</div>
        <div class="stat-label">browsers, captured {capturedDate}</div>
      </div>
    </div>

    <div class="browser-toggle" role="tablist" aria-label="Browser">
      {
        panes.map((pane, i) => (
          <>
            <input
              type="radio"
              name="bench-browser"
              id={`toggle-${pane.project}`}
              checked={i === 0}
            />
            <label for={`toggle-${pane.project}`} role="tab">
              {pane.label} {pane.results.browser.version.split(".")[0]}
            </label>
          </>
        ))
      }
    </div>

    {panes.map((pane) => <BenchBrowser results={pane.results} paneId={`pane-${pane.project}`} />)}

    <section class="methodology prose">
      <h2>Methodology</h2>
      <ul>
        <li>
          Every engine runs in the same page, loading an identical scale-{first.config.scale}
          dataset ({first.dataset.totalRows.toLocaleString("en-US")} rows,
          {tableCount} tables) with the same SQL.
        </li>
        <li>
          Each query runs {first.suite.sampleCount} samples after one prepare step (each
          engine's genuine prepared statement — compile/plan only); the charts show medians of
          fresh statement executions, with p95 and prepare time in the tooltips and table.
        </li>
        <li>
          Results are compared by checksum across engines — a timing only counts when all engines
          return identical rows.
        </li>
        <li>
          Storage backends:
          <ul>
            {
              engineMeta.map(([engine, meta]) => (
                <li>
                  <strong>{engine}</strong>
                  {meta.version !== undefined && meta.version !== "workspace"
                    ? ` ${meta.version}`
                    : ""} — {meta.persistence}
                </li>
              ))
            }
          </ul>
        </li>
        {
          first.browser.storage !== undefined && (
            <li>
              Captured in a persistent browser profile, so disk-backed engines write genuinely
              durable storage — not the memory-backed IndexedDB of an ephemeral automation
              context.
            </li>
          )
        }
        <li>
          Captured headless on an {first.host.model} ({first.host.cpus} cores). Absolute numbers
          vary by machine; the relationships are the point.
        </li>
        <li>
          The harness and dataset generator are in the repository, and the raw capture JSON lives
          beside this page (<code>apps/site/src/data/benchmarks/</code>) — this page is generated
          from it, so the page and the record cannot disagree.
        </li>
      </ul>
      <p>
        Every engine reports the same two numbers: a one-time prepare (statement compilation and
        planning — no engine pins data) and the median of fresh statement executions over
        current data. Minnow's executions stream through its block buffer pool and are
        snapshot-fresh on every statement.
      </p>
      {
        memoryEngines.length > 0 && (
          <p class="disclosure">
            <strong>Not a storage peer:</strong>{" "}
            {memoryEngines
              .map(([engine]) => engineLabels[engine] ?? engine)
              .join(" and ")}{" "}
            runs fully in memory in this harness ({memoryEngines
              .map(([, meta]) => meta.persistence)
              .join("; ")}). Its numbers exclude all storage I/O and are not directly comparable
            to the disk-backed engines; it is included as an executor reference. Its ingest
            timing carries the same caveat, since ingest for the other engines is dominated by
            exactly the storage writes it skips.
          </p>
        )
      }
    </section>
  </main>
</Base>

<style define:vars={{}}>
  .bench {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;

    /* dataviz tokens — categorical slots 1–3, validated all-pairs on these surfaces */
    --viz-surface: var(--bg);
    --viz-series-1: #2a78d6;
    --viz-series-2: #eb6834;
    --viz-series-3: #1baf7a;
    --viz-series-4: #8b63d6;
    --viz-muted: #898781;
    --viz-grid: #e1e0d9;
  }

  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .bench {
      --viz-series-1: #3987e5;
      --viz-series-2: #d95926;
      --viz-series-3: #199e70;
      --viz-series-4: #9a75e3;
      --viz-grid: #2c2c2a;
    }
  }

  :global(:root[data-theme="dark"]) .bench {
    --viz-series-1: #3987e5;
    --viz-series-2: #d95926;
    --viz-series-3: #199e70;
    --viz-series-4: #9a75e3;
    --viz-grid: #2c2c2a;
  }

  .bench-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.3em;
  }

  .lede {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 46rem;
    margin: 0 0 1.8rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .stat {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
  }

  .stat-value {
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .browser-toggle {
    display: inline-flex;
    gap: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.2rem;
    margin-bottom: 1.25rem;
  }

  .browser-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .browser-toggle label {
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--text-secondary);
    padding: 0.3rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 120ms ease;
  }

  .browser-toggle label:hover {
    background: var(--bg-hover);
  }

  .methodology {
    margin-top: 2.5rem;
  }

  .methodology h2 {
    font-size: 1.3rem;
    font-weight: 650;
  }

  .methodology .disclosure {
    border-left: 3px solid var(--viz-series-2);
    padding: 0.5rem 0.9rem;
    background: color-mix(in srgb, var(--viz-series-2) 7%, transparent);
    border-radius: 0 6px 6px 0;
  }
</style>

<style is:global>
  /* Radio-driven pane switching: hide every pane, show the checked browser's. */
  .bench section.bench-pane {
    display: none;
  }

  .bench:has(#toggle-chromium:checked) #pane-chromium,
  .bench:has(#toggle-firefox:checked) #pane-firefox,
  .bench:has(#toggle-webkit:checked) #pane-webkit {
    display: grid;
  }

  .bench .browser-toggle input:checked + label {
    background: var(--accent-bg);
    color: var(--accent);
  }
</style>
