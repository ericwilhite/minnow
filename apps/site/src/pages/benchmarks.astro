---
import Base from "../layouts/Base.astro";
import BenchBrowser, { type BenchResults } from "../components/BenchBrowser.astro";
import librarySizes from "../data/library-sizes.json";

// Pick the newest engine-comparison capture per browser, decided by the recorded
// capturedAt timestamp rather than filename order. The site is the only home for
// benchmark results; captures land in src/data/benchmarks/.
const resultModules = import.meta.glob<{ default: BenchResults }>(
  "../data/benchmarks/*engine-comparison*.json",
  { eager: true },
);
const benchmarkEngineIds = ["minnow", "sqlite", "pglite"];
const hasBenchmarkEngines = (engines: string[]): boolean =>
  engines.length === benchmarkEngineIds.length &&
  benchmarkEngineIds.every((engine) => engines.includes(engine));
// Captures key on (scale, browser): different scales publish side by side, and within a
// key the newest capturedAt wins.
const byPane = new Map<string, BenchResults>();
for (const module of Object.values(resultModules)) {
  const results = module.default;
  if (
    results.schemaVersion !== 1 ||
    results.kind !== "engine-comparison" ||
    !hasBenchmarkEngines(results.config.engines) ||
    !hasBenchmarkEngines(results.reads.engines) ||
    !hasBenchmarkEngines(results.writes.engines) ||
    !hasBenchmarkEngines(Object.keys(results.dataset.engines)) ||
    !results.reads.passed ||
    !results.writes.passed ||
    !["oltp", "olap"].every(
      (workload) =>
        results.reads.queries.some((query) => query.workload === workload) &&
        results.writes.cases.some((entry) => entry.workload === workload),
    )
  ) {
    throw new Error(`Invalid or failed benchmark capture: ${results.capturedAt}`);
  }
  const key = `${String(results.config.scale)}-${results.browser.project}`;
  const current = byPane.get(key);
  if (current === undefined || results.capturedAt > current.capturedAt) {
    byPane.set(key, results);
  }
}
// Smallest scale first: the realistic dataset is the headline, larger scales stay a click away.
const scales = [...new Set([...byPane.values()].map((results) => results.config.scale))].sort(
  (left, right) => left - right,
);
const panes = [...byPane.values()]
  .map((results) => ({
    results,
    scale: results.config.scale,
    project: results.browser.project,
    label: results.browser.project.charAt(0).toUpperCase() + results.browser.project.slice(1),
  }))
  .sort((left, right) => left.scale - right.scale || left.project.localeCompare(right.project));
const projects = [...new Set(panes.map((pane) => pane.project))].sort();
const first = panes[0]?.results;
if (first === undefined) throw new Error("No engine-comparison results found");
const capturedDate = first.capturedAt.slice(0, 10);
const tableCount = Object.keys(first.dataset.tableRows).length;
const engineMeta = Object.entries(first.dataset.engines);
const scaleStats = scales.map((scale) => {
  const results = panes.find((pane) => pane.scale === scale)?.results;
  if (results === undefined) throw new Error("Missing scale pane");
  return { scale, totalRows: results.dataset.totalRows };
});
const fmtRows = (rows: number): string =>
  rows >= 1_000_000 ? `${(rows / 1_000_000).toFixed(1)}M` : `${(rows / 1000).toFixed(0)}k`;
const engineLabels: Record<string, string> = {
  minnow: "Minnow",
  sqlite: "SQLite WASM",
  pglite: "PGlite",
};

// Download size, measured from the installed packages by scripts/measure-library-sizes.mts.
// Ordered smallest first, and scaled against the smallest so the bars read as a ratio.
const sizes = [...librarySizes.engines].sort((left, right) => left.totalGzipBytes - right.totalGzipBytes);
const smallestGzip = sizes[0]?.totalGzipBytes ?? 1;
const largestGzip = sizes.at(-1)?.totalGzipBytes ?? 1;
const sizeMeasuredDate = librarySizes.measuredAt.slice(0, 10);
const fmtBytes = (bytes: number): string =>
  bytes >= 1024 * 1024
    ? `${(bytes / 1024 / 1024).toFixed(bytes >= 10 * 1024 * 1024 ? 0 : 1)} MB`
    : `${(bytes / 1024).toFixed(0)} KB`;
const fmtMultiple = (bytes: number): string => {
  const multiple = bytes / smallestGzip;
  return multiple < 1.05 ? "smallest" : `${multiple.toFixed(multiple < 10 ? 1 : 0)}× larger`;
};
---

<Base
  title="Benchmarks · Minnow"
  description="Minnow measured against SQLite WASM and PGlite in real browsers, with published methodology."
>
  <main class="bench">
    <header class="bench-header">
      <h1>Benchmarks</h1>
      <p class="lede">
        {engineMeta.map(([engine]) => engineLabels[engine] ?? engine).join(", ")} running OLTP and
        OLAP reads and writes against identical commerce datasets ({scaleStats
          .map((entry) => fmtRows(entry.totalRows))
          .join(", ")} rows) in real browsers. Every result is verified against an independent
        oracle before any timing counts.
      </p>
    </header>

    {
      scaleStats.map((entry) => (
        <div class={`stats scale-stats scale-stats-${String(entry.scale)}`} role="list">
          <div class="stat" role="listitem">
            <div class="stat-value">{fmtRows(entry.totalRows)}</div>
            <div class="stat-label">rows across {tableCount} tables</div>
          </div>
          <div class="stat" role="listitem">
            <div class="stat-value">{first.reads.queries.length}</div>
            <div class="stat-label">verified read queries</div>
          </div>
          <div class="stat" role="listitem">
            <div class="stat-value">{first.writes.cases.length}</div>
            <div class="stat-label">verified write cases</div>
          </div>
          <div class="stat" role="listitem">
            <div class="stat-value">{projects.length}</div>
            <div class="stat-label">browsers, captured {capturedDate}</div>
          </div>
        </div>
      ))
    }

    <section class="library-size" aria-labelledby="size-heading">
      <div class="section-heading">
        <p class="eyebrow">Download size</p>
        <h2 id="size-heading">What the browser has to fetch first</h2>
        <p>
          Before any query runs, the page pays for the engine itself. Gzipped bytes over the
          wire, measured {sizeMeasuredDate} from the published packages: each engine's browser
          entry bundled and minified the same way, plus the WebAssembly and data files it
          fetches at run time.
        </p>
      </div>
      <ol class="size-list">
        {
          sizes.map((engine) => (
            <li class:list={["size-row", { "size-row-minnow": engine.id === "minnow" }]}>
              <div class="size-name">
                <strong>{engine.name}</strong>
                <span class="size-version">{engine.package} {engine.version}</span>
              </div>
              <div class="size-bar-track">
                <div
                  class="size-bar"
                  style={`width: ${String(Math.max(1.5, (engine.totalGzipBytes / largestGzip) * 100))}%`}
                />
              </div>
              <div class="size-numbers">
                <strong>{fmtBytes(engine.totalGzipBytes)}</strong>
                <span class="size-raw">{fmtBytes(engine.totalBytes)} uncompressed</span>
              </div>
              <div class="size-multiple">{fmtMultiple(engine.totalGzipBytes)}</div>
              <p class="size-note">
                {engine.note}{" "}
                {engine.assets.length > 1 && (
                  <span class="size-breakdown">
                    {engine.assets
                      .map((asset) => `${asset.name.replace(" (bundled, minified)", "")} ${fmtBytes(asset.gzipBytes)}`)
                      .join(" · ")}
                  </span>
                )}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="size-method">
        Reproduce with <code>npm run benchmark:sizes</code>; the measurement lands in{" "}
        <code>apps/site/src/data/library-sizes.json</code>, which this section is generated from.
      </p>
    </section>

    <section class="workload-coverage" aria-labelledby="workload-heading">
      <div class="section-heading">
        <p class="eyebrow">Coverage</p>
        <h2 id="workload-heading">Four workloads, kept separate</h2>
        <p>
          A single blended score hides the trade-offs that matter. The results below preserve the
          read/write and OLTP/OLAP boundaries from capture through rendering.
        </p>
      </div>
      <div class="workload-grid">
        <article>
          <strong>OLTP reads</strong>
          <span>Keys, small sets, and bounded ranges</span>
        </article>
        <article>
          <strong>OLAP reads</strong>
          <span>Scans, joins, windows, and aggregates</span>
        </article>
        <article>
          <strong>OLTP writes</strong>
          <span>Point and small-batch mutations</span>
        </article>
        <article>
          <strong>OLAP writes</strong>
          <span>Bulk ingestion and mutation batches</span>
        </article>
      </div>
    </section>

    {
      scales.length > 1 && (
        <div class="browser-toggle scale-toggle" role="tablist" aria-label="Dataset scale">
          {scales.map((scale, i) => (
            <>
              <input
                type="radio"
                name="bench-scale"
                id={`scale-${String(scale)}`}
                checked={i === 0}
              />
              <label for={`scale-${String(scale)}`} role="tab">
                {fmtRows(scaleStats.find((entry) => entry.scale === scale)?.totalRows ?? 0)} rows
              </label>
            </>
          ))}
        </div>
      )
    }

    <div class="browser-toggle" role="tablist" aria-label="Browser">
      {
        projects.map((project, i) => (
          <>
            <input type="radio" name="bench-browser" id={`toggle-${project}`} checked={i === 0} />
            <label for={`toggle-${project}`} role="tab">
              {project.charAt(0).toUpperCase() + project.slice(1)}{" "}
              {panes.find((pane) => pane.project === project)?.results.browser.version.split(
                ".",
              )[0] ?? ""}
            </label>
          </>
        ))
      }
    </div>

    {
      panes.map((pane) => (
        <BenchBrowser
          results={pane.results}
          paneId={`pane-${String(pane.scale)}-${pane.project}`}
        />
      ))
    }

    <section class="methodology prose">
      <h2>Methodology</h2>
      <ul>
        <li>
          Every engine runs in the same page, loading identical datasets ({scaleStats
            .map((entry) => `scale ${String(entry.scale)}: ${entry.totalRows.toLocaleString("en-US")} rows`)
            .join("; ")}; {tableCount} tables) with the same SQL.
        </li>
        <li>
          Each query runs {first.reads.sampleCount} samples after one prepare step (each
          engine's genuine prepared statement — compile/plan only); the charts show medians of
          fresh statement executions, with p95 and prepare time in the tooltips and table.
        </li>
        <li>
          Reads are compared against independent JavaScript oracles and across engines. Writes
          read the final table back and compare every row with an independent oracle.
        </li>
        <li>
          Storage backends:
          <ul>
            {
              engineMeta.map(([engine, meta]) => (
                <li>
                  <strong>{engine}</strong>
                  {meta.version !== undefined && meta.version !== "workspace"
                    ? ` ${meta.version}`
                    : ""} — {meta.persistence}
                </li>
              ))
            }
          </ul>
        </li>
        {
          first.browser.storage !== undefined && (
            <li>
              Captured in a persistent browser profile, so disk-backed engines write genuinely
              durable storage — not the memory-backed IndexedDB of an ephemeral automation
              context.
            </li>
          )
        }
        <li>
          <strong>Every engine runs on its shipped defaults.</strong> No pragmas, no{" "}
          <code>work_mem</code>, no cache sizing — nothing that depends on tuning knowledge the
          next person might not apply. Durability is the one setting that is matched rather than
          left alone: Minnow's IndexedDB store runs relaxed, so PGlite's read sessions open with{" "}
          <code>relaxedDurability</code> too. Without it PGlite flushes its whole filesystem
          image to IndexedDB after every statement, which put a fixed ~13–20 ms round trip on
          every read — a single-row key lookup cost the same as a full aggregate. PGlite's
          writes stay strict, because its relaxed flush races its own IndexedDB connection under
          sustained writes and loses data mid-load. Minnow's own defaults include a
          64 MiB buffer pool and relaxed IndexedDB durability; the dataset is written with
          gzip-compressed blocks, which trades query speed for stored size rather than the other
          way round. All engines get identical schemas, post-load statistics where they have them
          (<code>PRAGMA optimize</code> / <code>ANALYZE</code>), and genuine prepared statements.
        </li>
        <li>
          The two comparison engines also get a B-tree secondary index on every foreign key.
          Minnow gets none: it has no secondary-index feature, and its scans are pruned by the
          zone statistics carried in each column block. The comparison is deliberately run
          this way — with the other engines indexed and Minnow not — rather than removing
          indexes to flatter it.
        </li>
        <li>
          Captured headless on an {first.host.model} ({first.host.cpus} cores). Absolute numbers
          vary by machine; the relationships are the point.
        </li>
        <li>
          The harness and dataset generator are in the repository, and the raw capture JSON lives
          beside this page (<code>apps/site/src/data/benchmarks/</code>) — this page is generated
          from it, so the page and the record cannot disagree.
        </li>
      </ul>
      <p>
        Every engine reports the same two numbers: a one-time prepare (statement compilation and
        planning — no engine pins data) and the median of fresh statement executions over
        current data. Minnow's executions stream through its block buffer pool and are
        snapshot-fresh on every statement.
      </p>
      <p>
        <strong>Memory</strong> is reported per query, and only by Minnow, because the browser
        gives us nothing comparable. <code>performance.measureUserAgentSpecificMemory()</code> —
        the one API that counts a WebAssembly engine's heap as well as the JavaScript one —
        throws <code>SecurityError</code> in the Chromium build Playwright ships (it needs full
        site isolation), is not exposed inside workers at all, where these engines actually run,
        and does not exist in Firefox. Launch flags do not change that; we tried. So rather than
        publish a number we cannot stand behind across engines, the page publishes the one
        that is exact: Minnow reserves memory before it allocates it, so it knows its own peak
        for each statement and reports it. Compare it across queries, not across engines.
      </p>
      <p>
        Summaries are a <strong>geometric mean</strong>, not a sum. These queries span three
        orders of magnitude, so adding them up reports the slowest few and nothing else — an
        engine could lose every fast query and still win the total. A geometric mean weights
        each query equally whatever it costs. OLTP and OLAP reads get separate summaries because
        engines that win on scanning and aggregating are frequently not the ones that win on
        reaching a single row.
      </p>
      <p>
        The suite replays one statement over unchanging data, which is a measurement artifact,
        not a workload. Minnow caches computed results by default and would answer every sample
        after the first from that cache — so the headline number is measured with the cache off,
        and every table cell also carries the cached figure beneath it. Both are real: the first
        is what the engine costs when it runs the query, and it is the only one comparable to
        SQLite and PGlite, neither of which cache results; the second is what a repeat
        actually costs an application that keeps the default. A commit invalidates the cache, so
        it never serves a stale row — it just isn't query execution, and putting it in the same
        column as the comparison engines' execution times would be comparing two different
        quantities.
      </p>
    </section>
  </main>
</Base>

<style define:vars={{}}>
  .bench {
    max-width: 74rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;

    /* dataviz tokens — categorical slots 1–3, validated all-pairs on these surfaces */
    --viz-surface: var(--bg);
    --viz-series-1: #2a78d6;
    --viz-series-2: #eb6834;
    --viz-series-3: #1baf7a;
    --viz-muted: #898781;
    --viz-grid: #e1e0d9;
  }

  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .bench {
      --viz-series-1: #3987e5;
      --viz-series-2: #d95926;
      --viz-series-3: #199e70;
      --viz-grid: #2c2c2a;
    }
  }

  :global(:root[data-theme="dark"]) .bench {
    --viz-series-1: #3987e5;
    --viz-series-2: #d95926;
    --viz-series-3: #199e70;
    --viz-grid: #2c2c2a;
  }

  .bench-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.3em;
  }

  .lede {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 46rem;
    margin: 0 0 1.8rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .stat {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
  }

  .stat-value {
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .browser-toggle {
    display: inline-flex;
    gap: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.2rem;
    margin-bottom: 1.25rem;
  }

  .workload-coverage {
    margin: 2rem 0;
  }
  .library-size {
    margin: 2rem 0;
  }
  .size-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .size-row {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 2.2fr) minmax(7rem, auto) minmax(5.5rem, auto);
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .size-row-minnow {
    border-color: var(--viz-series-1);
  }
  .size-name strong {
    display: block;
    font-size: 1rem;
  }
  .size-version {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .size-bar-track {
    height: 0.6rem;
    border-radius: 0.3rem;
    background: var(--viz-grid);
    overflow: hidden;
  }
  .size-bar {
    height: 100%;
    border-radius: 0.3rem;
    background: var(--viz-series-2);
  }
  .size-row-minnow .size-bar {
    background: var(--viz-series-1);
  }
  .size-numbers {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .size-numbers strong {
    display: block;
    font-size: 1.05rem;
  }
  .size-raw {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .size-multiple {
    text-align: right;
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .size-note {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .size-breakdown {
    font-variant-numeric: tabular-nums;
  }
  .size-method {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .size-row {
      grid-template-columns: 1fr auto;
    }
    .size-bar-track {
      grid-column: 1 / -1;
      order: 3;
    }
    .size-note {
      order: 4;
    }
  }

  .section-heading h2 {
    font-size: 1.35rem;
    margin: 0.1rem 0 0.25rem;
  }

  .section-heading p:not(.eyebrow) {
    color: var(--text-secondary);
    margin: 0;
    max-width: 48rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  .workload-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .workload-grid article {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1rem;
  }

  .workload-grid strong,
  .workload-grid span {
    display: block;
  }

  .workload-grid span {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin-top: 0.2rem;
  }

  @media (max-width: 760px) {
    .workload-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .browser-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .browser-toggle label {
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--text-secondary);
    padding: 0.3rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 120ms ease;
  }

  .browser-toggle label:hover {
    background: var(--bg-hover);
  }

  .methodology {
    margin-top: 2.5rem;
  }

  .methodology h2 {
    font-size: 1.3rem;
    font-weight: 650;
  }

  .methodology code {
    overflow-wrap: anywhere;
  }

  .methodology .disclosure {
    border-left: 3px solid var(--viz-series-2);
    padding: 0.5rem 0.9rem;
    background: color-mix(in srgb, var(--viz-series-2) 7%, transparent);
    border-radius: 0 6px 6px 0;
  }
</style>

<style is:global>
  /* Radio-driven pane switching: hide every pane, show the checked (scale, browser) one.
     Selectors enumerate the published matrix; a new scale adds one line per browser. */
  .bench section.bench-pane {
    display: none;
  }

  .bench .scale-stats {
    display: none;
  }

  .bench:not(:has(input[name="bench-scale"])) .scale-stats,
  .bench:has(#scale-1:checked) .scale-stats-1,
  .bench:has(#scale-5:checked) .scale-stats-5,
  .bench:has(#scale-25:checked) .scale-stats-25 {
    display: grid;
  }

  .bench:not(:has(input[name="bench-scale"])):has(#toggle-chromium:checked)
    section[id$="-chromium"],
  .bench:not(:has(input[name="bench-scale"])):has(#toggle-firefox:checked) section[id$="-firefox"],
  .bench:has(#scale-1:checked):has(#toggle-chromium:checked) #pane-1-chromium,
  .bench:has(#scale-1:checked):has(#toggle-firefox:checked) #pane-1-firefox,
  .bench:has(#scale-5:checked):has(#toggle-chromium:checked) #pane-5-chromium,
  .bench:has(#scale-5:checked):has(#toggle-firefox:checked) #pane-5-firefox,
  .bench:has(#scale-25:checked):has(#toggle-chromium:checked) #pane-25-chromium,
  .bench:has(#scale-25:checked):has(#toggle-firefox:checked) #pane-25-firefox {
    display: grid;
  }

  .bench .browser-toggle input:checked + label {
    background: var(--accent-bg);
    color: var(--accent);
  }
</style>
