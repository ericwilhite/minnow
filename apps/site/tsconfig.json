{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The site is bundled by Next rather than built as a project reference, so it opts out of
    // the base's composite declaration emit and type-checks in place.
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "incremental": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker"],
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out", ".next"]
}
