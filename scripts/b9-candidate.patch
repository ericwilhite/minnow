+    const { ndv: actualNdv, ...actualMetadata } = a;
+    const { ndv: expectedNdv, ...expectedMetadata } = e;
+    expect(actualMetadata).toEqual(expectedMetadata);
+    if (!actualNdv || !expectedNdv) {
+      expect(actualNdv).toEqual(expectedNdv);
+      continue;
+    }
+    const { bytes: actualBytes, ...actualHint } = actualNdv;
+    const { bytes: expectedBytes, ...expectedHint } = expectedNdv;
+    expect(actualHint).toEqual(expectedHint);
