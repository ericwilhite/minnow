@@ -0,0 +1,123 @@
+/** Persisted HLL is advisory: even deliberately wrong estimates must preserve PG bags and types. */
+import fc from "fast-check";
+import { PGlite } from "@electric-sql/pglite";
+import { expect, it, vi } from "vitest";
+import { seedsFor } from "../../testing/seeds.js";
+import { createReach, B9_NDV_ADVISORY_REACH } from "../../testing/reach.js";
+import { Governor } from "../memory/governor.js";
+import { StorageCore } from "./storage-core.js";
+import { oracleRows } from "./differential-adapter.js";
+
+it.each(seedsFor("b9-ndv-advisory", [0xb9df1, 0xb9df2]))(
+  "published estimates never prove pruning uniqueness or admission seed %i",
+  async (seed) => {
+    const core = await new StorageCore(8).open(),
+      pg = new PGlite();
+    const originalGovernor = core.harness.governor;
+    const reach = createReach("B9 advisory NDV", B9_NDV_ADVISORY_REACH);
+    try {
+      await pg.waitReady;
+      // PGlite's JS text result decoder drops a leading BOM. PostgreSQL's own
+      // length/hex functions prove the original value is present, so compare a
+      // lossless prefixed projection while grouping/ordering on the original key.
+      const bom = await pg.query(
+        "SELECT octet_length('\ufeff'::text) AS octets,encode(convert_to('\ufeff'::text,'UTF8'),'hex') AS hex,length('\ufeff'::text) AS chars,'key:'||'\ufeff'::text AS prefixed",
+      );
+      expect(bom.rows).toEqual([{ octets: 3, hex: "efbbbf", chars: 1, prefixed: "key:\ufeff" }]);
+      await fc.assert(
+        fc.asyncProperty(
+          fc.integer({ min: 2, max: 32 }),
+          fc.integer({ min: 0, max: 3 }),
+          fc.constantFrom("zero", "one", "huge", "unknown"),
+          fc.boolean(),
+          async (count, rotation, mode, grouped) => {
+            reach.beginHistory();
+            const labels = ["", "x", "λ", "\ufeff"];
+            for (const [table, shift] of [
+              ["advice_a", 0],
+              ["advice_b", rotation],
+            ] as const) {
+              for (const sql of [
+                `DROP TABLE IF EXISTS ${table}`,
+                `CREATE TABLE ${table}(id INT PRIMARY KEY,k TEXT)`,
+              ]) {
+                await core.execute(sql);
+                await pg.exec(sql);
+              }
+              const sql = `INSERT INTO ${table} VALUES ${Array.from({ length: count }, (_, i) => `(${String(i)},${i % 11 === 0 ? "NULL" : `'${labels[(i + shift) % 4] ?? ""}'`})`).join(",")}`;
+              await core.execute(sql);
+              await pg.exec(sql);
+            }
+            await core.harness.path.recycleLog();
+            await core.harness.path.quiesce();
+            await core.harness.reopen();
+            const fake = mode === "zero" ? 0 : mode === "one" ? 1 : mode === "huge" ? 1e12 : null;
+            const context = core.context.bind(core);
+            let reads = 0,
+              columns = 0;
+            const spy = vi.spyOn(core, "context").mockImplementation(() => ({
+              ...context(),
+              statistics: {
+                table: (id) => {
+                  const source = core.harness.path.statistics(id);
+                  if (!source) return null;
+                  reads++;
+                  return {
+                    rowCount: fake ?? source.rowCount,
+                    column: (columnId) => {
+                      const column = source.column(columnId);
+                      if (!column) return null;
+                      columns++;
+                      if (column.distinct !== null) reach.reach("cold published NDV consumed");
+                      return { ...column, distinct: fake, averageWidth: mode === "huge" ? 1e9 : 1 };
+                    },
+                  };
+                },
+              },
+            }));
+            const governor = new Governor(96 << 20);
+            Object.assign(core.harness, { governor });
+            try {
+              // Total COUNT-only queries exercise costing without changing unordered float
+              // transitions or competing expression errors. Ordinary composition wiring is separate.
+              const sql = grouped
+                ? "SELECT 'key:' || a.k AS k,COUNT(*) AS n FROM advice_a a JOIN advice_b b ON a.k=b.k WHERE b.id>=0 GROUP BY a.k ORDER BY a.k"
+                : "SELECT COUNT(*) AS n FROM advice_a a JOIN advice_b b ON a.k=b.k WHERE b.id>=0";
+              const actual = await core.execute(sql);
+              if (!("batches" in actual)) throw Error("rows");
+              expect(oracleRows(actual)).toEqual((await pg.query(sql)).rows);
+              expect(reads).toBeGreaterThan(0);
+              expect(columns).toBeGreaterThan(0);
+              expect(governor.usedBytes).toBe(0);
+              expect(governor.peakBytes).toBeLessThanOrEqual(governor.capBytes);
+              reach.reach(mode);
+              reach.reach(grouped ? "grouped ordered keys" : "scalar count");
+              reach.reach("duplicates NULL empty Unicode BOM");
+              reach.reach("96MiB complete query");
+              reach.reach("PGlite exact rows and count types");
+              reach.reach("zero query credits");
+            } finally {
+              spy.mockRestore();
+              Object.assign(core.harness, { governor: originalGovernor });
+            }
+          },
+        ),
+        {
+          seed,
+          numRuns: 24,
+          examples: [
+            [8, 1, "zero", true],
+            [8, 2, "one", false],
+            [8, 3, "huge", true],
+            [8, 0, "unknown", false],
+          ],
+        },
+      );
+      reach.assertReached();
+    } finally {
+      await core.close();
+      await pg.close();
+    }
+  },
+  120000,
+);
diff --git a/packages/core/src/next/testing/ndv.test.ts b/packages/core/src/next/testing/ndv.test.ts
new file mode 100644
index 00000000..01341d91
--- /dev/null
+++ b/packages/core/src/next/testing/ndv.test.ts
@@ -0,0 +1,134 @@
+/** HLL register maximum is the page/sketch.ts law; estimates are planning advice. */
+import { expect, it } from "vitest";
+import { seedsFor, mulberry32 } from "../../testing/seeds.js";
+import { createReach, B9_NDV_LEASE_REACH } from "../../testing/reach.js";
+import { DistinctSketch, mix32 } from "../page/sketch.js";
+import {
+  estimateNdv,
+  mergeNdv,
+  ownNdv,
+  ndvDomain,
+  validateNdv,
+  type EncodedNdv,
+} from "../format/ndv.js";
+it.each(seedsFor("b9-ndv-leases", [0xb9db1, 0xb9db2]))(
+  "encoded union owns every generation and uses bounded optional credit seed %i",
+  (seed) => {
+    const random = mulberry32(seed),
+      reach = createReach("B9 NDV leases", B9_NDV_LEASE_REACH);
+    reach.beginHistory();
+    let used = 0,
+      peak = 0,
+      limit = 8192;
+    const budget = {
+      allocate(n: number) {
+        if (used + n > limit) return false;
+        used += n;
+        peak = Math.max(peak, used);
+        return true;
+      },
+      free(n: number) {
+        used -= n;
+        expect(used).toBeGreaterThanOrEqual(0);
+      },
+    };
+    for (let round = 0; round < 24; round++) {
+      const a = new DistinctSketch(),
+        b = new DistinctSketch(),
+        n = round === 0 ? 0 : Math.floor(random() * 4096);
+      for (let k = 0; k < n; k++) {
+        const hash = mix32(Math.floor(random() * 10000));
+        if (k % 3 !== 0) a.add(hash);
+        if (k % 3 !== 1) b.add(hash);
+      }
+      const left: EncodedNdv = { domain: 9, scale: null, bytes: a.serialize() },
+        right: EncodedNdv = { domain: 9, scale: null, bytes: b.serialize() },
+        want = Uint8Array.from(a.registers, (rank, i) => Math.max(rank, b.registers[i] ?? 0)),
+        savedA = new Uint8Array(left.bytes),
+        savedB = new Uint8Array(right.bytes);
+      const old = ownNdv(left, budget);
+      expect(old).not.toBeNull();
+      if (!old) throw Error("funded old generation");
+      old.retain();
+      left.bytes.fill(0);
+      expect(old.value.bytes).toEqual(savedA);
+      left.bytes.set(savedA);
+      const next = mergeNdv(old.value, right, budget);
+      expect(next).not.toBeNull();
+      if (!next) throw Error("funded union");
+      expect(DistinctSketch.parse(next.value.bytes).registers).toEqual(want);
+      expect(left.bytes).toEqual(savedA);
+      expect(right.bytes).toEqual(savedB);
+      expect(old.value.bytes).toEqual(savedA);
+      const first = estimateNdv(next.value);
+      expect(first).toBe(DistinctSketch.parse(next.value.bytes).estimate());
+      expect(estimateNdv(next.value)).toBe(first);
+      const repeat = mergeNdv(next.value, right, budget);
+      expect(repeat).not.toBeNull();
