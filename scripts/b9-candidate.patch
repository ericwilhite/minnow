+          values: 1,
+          bytes: 300,
+          unbounded: false,
+          min: bound,
+          max: bound,
+          ndv: { domain: 9, scale: null, bytes: dense.serialize() },
+        })),
+      },
+      encoded = codec.encodeTableStatistics(many);
+    expect(encoded.length).toBeLessThanOrEqual(MAX_BLOB_BYTES);
+    const b = budget(),
+      decoded = codec.decodeTableStatistics(encoded, b),
+      known = decoded.value.columns.map((c) => c.ndv !== undefined),
+      firstUnknown = known.indexOf(false);
