+      ...plain,
+      columns: [
+        {
+          ...column,
+          values: 1,
+          min: 0,
+          max: 0,
+          ndv: { domain: 9, scale: null, bytes: dense.serialize() },
+        },
+      ],
+    });
+    let held = 0;
+    const limited = {
+      allocate(n: number) {
+        if (held + n > 1024) return false;
+        held += n;
+        return true;
+      },
+      free(n: number) {
+        held -= n;
