+  : current;
+function budget() {
+  let used = 0;
+  return {
+    get used() {
+      return used;
+    },
+    allocate(n: number) {
+      used += n;
+      return true;
+    },
+    free(n: number) {
+      used -= n;
+      expect(used).toBeGreaterThanOrEqual(0);
+    },
+  };
+}
