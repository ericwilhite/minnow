index 00000000..11062f2a
--- /dev/null
+++ b/packages/core/src/next/write/statistics-ndv.test.ts
@@ -0,0 +1,170 @@
+/** Cold ordinary opens expose advisory NDV without scanning existing group roots.
+ * Published/older pinned statistics own distinct encoded generations under native credit. */
+import { expect, it } from "vitest";
+import { seedsFor, mulberry32 } from "../../testing/seeds.js";
+import { createReach, B9_NDV_PUBLICATION_REACH } from "../../testing/reach.js";
+import { Governor } from "../memory/governor.js";
+import {
+  Harness,
+  autocommit,
+  batch,
+  column,
+  ints,
+  texts,
+  INT,
+  TEXT,
+  tableInput,
+} from "./test-support.js";
+import { need } from "./bytes.js";
+import { MetadataBudget } from "./budget.js";
+import type { ColumnSummary } from "../access/write-path.js";
+const near = (column: ColumnSummary | null, expected: number) => {
+  const n = column?.distinct;
+  expect(typeof n).toBe("number");
+  if (typeof n !== "number") throw Error("missing cold NDV");
+  expect(Number.isFinite(n)).toBe(true);
+  expect(Math.abs(n - expected)).toBeLessThan(Math.max(1, expected * 0.2));
+};
+it.each(seedsFor("b9-ndv-publication", [0xb9dd1, 0xb9dd2]))(
+  "native32MiB writer keeps COW NDV across flush and cold reopen seed %i",
+  async (seed) => {
+    const random = mulberry32(seed),
+      reach = createReach("B9 NDV publication", B9_NDV_PUBLICATION_REACH),
+      h = new Harness("strict", "sim", 32),
+      governor = new Governor(32 << 20);
+    Object.assign(h, { governor });
+    reach.beginHistory();
+    let oldPin: ReturnType<Awaited<ReturnType<typeof h.open>>["pin"]> | null = null;
+    try {
+      let p = await h.open(),
+        t = 0;
+      await autocommit(p, async (s) => {
+        t =
+          (
+            await s.changeCatalog({
+              kind: "createTable",
+              table: tableInput("ndv", [
+                column("id", INT, false),
+                column("n", INT),
+                column("s", TEXT),
+              ]),
+            })
+          ).id ?? 0;
+      });
+      const [, numberColumn, textColumn] = need(p.catalog.table(t)).columns;
+      if (!numberColumn || !textColumn) throw Error("columns");
+      const numberColumnId = numberColumn.id;
+      const seenInt = new Set<number>(),
+        seenText = new Set<string>();
+      let nextId = 0;
+      async function insert(round: number) {
+        const numbers = Array.from({ length: 64 }, (_, i) =>
+            i % 13 === 0 ? null : round ? 100 + round * 64 + i : Math.floor(random() * 17),
+          ),
+          strings = numbers.map((n, i) =>
+            n === null
+              ? null
+              : round
+                ? `new-${String(round)}-${String(i)}`
+                : (["", "λ", "\ufeff", "x", "Ω"][Math.floor(random() * 5)] ?? ""),
+          );
+        for (const n of numbers) if (n !== null) seenInt.add(n);
+        for (const s of strings) if (s !== null) seenText.add(s);
+        await autocommit(p, async (tx) => {
+          await tx
+            .table(t)
+            .insert(batch(ints(numbers.map(() => nextId++)), ints(numbers), texts(strings)), null);
+          expect(p.statistics(t)?.column(numberColumnId)?.distinct).toBeNull();
+        });
+      }
+      for (let round = 0; round < 3; round++) await insert(0);
+      p.liveMemtable(t, 64);
+      await p.quiesce();
+      near(p.statistics(t)?.column(numberColumnId) ?? null, seenInt.size);
+      near(p.statistics(t)?.column(textColumn.id) ?? null, seenText.size);
+      reach.reach("flushed int text NDV populated");
+      reach.reach("NULL empty Unicode BOM distinct");
+      reach.reach("pending memtable NDV unknown");
+      const old = need(p.state().tables.get(t)?.statistics),
+        oldValue = need(old.columns.get(numberColumnId)?.ndv),
+        saved = new Uint8Array(oldValue.bytes);
+      oldPin = p.pin();
+      await insert(1);
+      p.liveMemtable(t, 64);
+      await p.quiesce();
+      const next = need(p.state().tables.get(t)?.statistics),
+        nextValue = need(next.columns.get(numberColumnId)?.ndv);
+      expect(next).not.toBe(old);
+      expect(nextValue.bytes.buffer).not.toBe(oldValue.bytes.buffer);
+      expect(oldValue.bytes).toEqual(saved);
+      expect(old.columns.size).toBeGreaterThan(0);
+      near(p.statistics(t)?.column(numberColumnId) ?? null, seenInt.size);
+      reach.reach("old pin owns unchanged encoded generation");
+      oldPin.release();
+      oldPin = null;
+      expect(old.columns.size).toBe(0);
+      reach.reach("old generation released after last pin");
+      let roots = 0,
+        statistics = 0;
+      h.onSpace = (space) => {
+        const read = space.read.bind(space);
+        space.read = async (refs, options) => {
+          const held = await read(refs, options);
+          for (const bytes of held.bytes) {
+            if (bytes[0] === 0x4d && bytes[1] === 0x47 && bytes[2] === 0x52 && bytes[3] === 0x31)
+              roots++;
+            if (bytes[0] === 0x4d && bytes[1] === 0x53 && bytes[2] === 0x54 && bytes[3] === 0x32)
+              statistics++;
+          }
+          return held;
+        };
+        const peek = space.peek.bind(space);
+        space.peek = (ref) => {
+          const bytes = peek(ref);
+          if (bytes?.[0] === 0x4d && bytes[1] === 0x47 && bytes[2] === 0x52 && bytes[3] === 0x31)
+            roots++;
+          return bytes;
+        };
+      };
+      p = await h.reopen();
+      h.onSpace = null;
+      expect(roots).toBe(0);
+      expect(statistics).toBeGreaterThan(0);
+      near(p.statistics(t)?.column(numberColumnId) ?? null, seenInt.size);
+      near(p.statistics(t)?.column(textColumn.id) ?? null, seenText.size);
+      reach.reach("cold ordinary open no group roots");
+      const last = need(p.state().tables.get(t)?.statistics);
+      oldPin = p.pin();
+      await p.close();
+      expect(last.columns.size).toBeGreaterThan(0);
+      expect(governor.usedBytes).toBeGreaterThanOrEqual(last.charge);
+      expect(last.budget).toBeInstanceOf(MetadataBudget);
+      if (!(last.budget instanceof MetadataBudget)) throw Error("native metadata budget missing");
+      expect(last.budget.grant.allocated).toBeGreaterThanOrEqual(last.charge);
+      oldPin.release();
+      oldPin = null;
+      expect(last.columns.size).toBe(0);
+      reach.reach("native close keeps pinned metadata charged");
+    } finally {
+      oldPin?.release();
+      await h.close();
+    }
+    expect(governor.peakBytes).toBeLessThanOrEqual(governor.capBytes);
+    expect(governor.usedBytes).toBe(0);
+    reach.reach("32MiB complete native owner");
+    reach.reach("zero final credit");
+    reach.assertReached();
+  },
+  120000,
+);
+
+it.each(seedsFor("b9-ndv-native-minimum", [0xb9dd1, 0xb9dd2]))(
+  "unchanged complete native owner refuses above available16MiB cap seed %i",
+  async () => {
+    const h = new Harness("strict", "sim", 32),
+      governor = new Governor(16 << 20);
+    Object.assign(h, { governor });
+    await expect(h.open()).rejects.toMatchObject({ sqlState: "53200" });
+    expect(governor.usedBytes).toBe(0);
+  },
+);
diff --git a/packages/core/src/next/write/statistics-owner.ts b/packages/core/src/next/write/statistics-owner.ts
