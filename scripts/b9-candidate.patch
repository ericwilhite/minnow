+    const reach = createReach("B9 ordinary MST2 refusal", B9_NDV_REFUSAL_REACH);
+    await fc.assert(
+      fc.asyncProperty(
+        fc.constantFrom(...modes),
+        fc.integer({ min: 8, max: 24 }),
+        async (mode, rows) => {
+          reach.beginHistory();
+          const h = new Harness("strict", "memory", 32);
+          let changed = 0;
+          h.onSpace = (space) => {
+            const begin = space.beginWrite.bind(space);
+            space.beginWrite = (...args) => {
+              const writer = begin(...args),
+                write = writer.write.bind(writer);
+              writer.write = (parts) =>
+                write(
+                  parts.map((bytes) => {
+                    if (
+                      bytes[0] !== 0x4d ||
+                      bytes[1] !== 0x53 ||
+                      bytes[2] !== 0x54 ||
+                      bytes[3] !== 0x32
+                    )
+                      return bytes;
+                    changed++;
+                    return alter(bytes, mode);
+                  }),
+                );
+              return writer;
+            };
+          };
+          try {
+            const p = await h.open();
+            let t = 0;
+            await autocommit(p, async (s) => {
+              t =
+                (
+                  await s.changeCatalog({
+                    kind: "createTable",
+                    table: tableInput("refusal", [column("id", INT, false)]),
+                  })
+                ).id ?? 0;
+            });
+            await autocommit(p, (s) =>
+              s.table(t).insert(batch(ints(Array.from({ length: rows }, (_, i) => i))), null),
+            );
+            await p.recycleLog();
+            await p.quiesce();
+            expect(changed).toBeGreaterThan(0);
+            reach.reach("checksummed malformed native payload");
+            h.onSpace = null;
+            await expect(h.reopen()).rejects.toMatchObject({ code: "MINNOW_MANIFEST_CORRUPT" });
+            reach.reach(mode);
+            reach.reach("ordinary reopen typed refusal");
+          } finally {
+            h.onSpace = null;
+            await h.close();
+          }
+          expect(h.governor.usedBytes).toBe(0);
+          reach.reach("zero final credits");
+        },
+      ),
+      { seed, numRuns: 21, examples: modes.map((mode) => [mode, 16] as [Mode, number]) },
+    );
+    reach.assertReached();
+  },
+  120000,
+);
diff --git a/packages/core/src/next/write/statistics-ndv-root-selection.test.ts b/packages/core/src/next/write/statistics-ndv-root-selection.test.ts
new file mode 100644
index 00000000..4297e06a
--- /dev/null
+++ b/packages/core/src/next/write/statistics-ndv-root-selection.test.ts
@@ -0,0 +1,166 @@
+/** R25 and the approved MST2 seam: the selected root owns every published hint.
+ * Real DROP commits on either side of catalog-cut selection; old paid advice stays pinned. */
+import fc from "fast-check";
+import { expect, it } from "vitest";
+import { seedsFor } from "../../testing/seeds.js";
+import { createReach, B9_NDV_ROOT_SELECTION_REACH } from "../../testing/reach.js";
+import type { Snapshot } from "../access/snapshot.js";
+import type { ExtentWriter } from "../storage/extents.js";
+import { Governor } from "../memory/governor.js";
+import { need } from "./bytes.js";
+import {
+  Harness,
+  autocommit,
+  batch,
+  column,
+  ints,
+  INT,
+  rowsOf,
+  tableInput,
+} from "./test-support.js";
+
+it.each(seedsFor("b9-ndv-root-selection", [0xb9e61, 0xb9e62]))(
+  "selected root owns paid NDV across DROP seed %i",
+  async (seed) => {
+    const reach = createReach("B9 NDV selected-root ownership", B9_NDV_ROOT_SELECTION_REACH);
+    await fc.assert(
+      fc.asyncProperty(
+        fc.integer({ min: 4, max: 12 }),
+        fc.integer({ min: -30, max: 30 }),
+        async (width, salt) => {
+          reach.beginHistory();
+          for (const phase of ["before", "after"] as const) {
+            let armed = false,
+              target = 0,
+              entered!: () => void,
+              resume!: () => void;
+            const at = new Promise<void>((r) => {
+                entered = r;
+              }),
+              gate = new Promise<void>((r) => {
+                resume = r;
+              }),
+              gov = new Governor(32 << 20),
+              h = new Harness("strict", "memory", width, undefined, {
+                merges: { mode: "off" },
+                rootSelectionBoundary: (boundary, operation) => {
+                  if (!armed || boundary !== phase || operation !== "flush")
+                    return Promise.resolve();
+                  armed = false;
+                  entered();
+                  return gate;
+                },
+              });
+            Object.assign(h, { governor: gov });
+            const flush: { writer: ExtentWriter | null } = { writer: null },
+              preparing = new Set<number>();
+            let installed = 0;
+            h.onSpace = (space) => {
+              const begin = space.beginWrite.bind(space);
+              space.beginWrite = (label, options) => {
+                const writer = begin(label, options);
+                if (armed && label === `flush t${String(target)}`) flush.writer = writer;
+                return writer;
+              };
+            };
+            h.extentDeltas = {
+              prepare(attempt, delta) {
+                if (delta.writer === flush.writer) preparing.add(attempt);
+                return null;
+              },
+              commit(attempt) {
+                if (preparing.delete(attempt)) installed++;
+              },
+              abort(attempt) {
+                preparing.delete(attempt);
+              },
+            };
+            let old: Snapshot | null = null;
+            try {
+              let p = await h.open(),
+                kept = 0;
+              await autocommit(p, async (s) => {
+                target =
+                  (
+                    await s.changeCatalog({
+                      kind: "createTable",
+                      table: tableInput("target", [column("id", INT, false)]),
+                    })
+                  ).id ?? 0;
+                kept =
+                  (
+                    await s.changeCatalog({
+                      kind: "createTable",
+                      table: tableInput("kept", [column("id", INT, false)]),
+                    })
+                  ).id ?? 0;
+              });
+              const first = Array.from({ length: width }, (_, i) => salt + i),
+                second = first.map((n) => n + width);
+              await autocommit(p, (s) => s.table(target).insert(batch(ints(first)), null));
+              p.liveMemtable(target, width);
+              await p.quiesce();
+              const generation = need(p.state().tables.get(target)?.statistics),
+                hint = need(generation.columns.values().next().value?.ndv),
+                saved = Buffer.from(hint.bytes);
+              old = p.pin();
+              armed = true;
+              await autocommit(p, (s) => s.table(target).insert(batch(ints(second)), null));
+              p.liveMemtable(target, width);
+              await at;
+              const writer = need(flush.writer);
+              expect(writer.extents.length).toBeGreaterThan(0);
+              reach.reach("sealed provisional hint output");
+              await autocommit(p, (s) => s.changeCatalog({ kind: "dropTable", tableId: target }));
+              resume();
+              await p.quiesce();
+              expect(p.failure).toBeNull();
+              expect(Buffer.from(hint.bytes).equals(saved)).toBe(true);
+              expect(await rowsOf(old, target)).toEqual(first.map((n) => [n]));
+              reach.reach("old pinned encoded generation unchanged");
+              expect(p.statistics(target)).toBeNull();
+              expect(h.space.stats.writerBytes).toBe(0);
+              if (phase === "before") {
+                expect(installed).toBe(0);
+                expect(p.maintenance.flushesAbandoned).toBeGreaterThan(0);
+                reach.reach("DROP before selection abandons output");
+              } else {
+                expect(installed).toBe(1);
+                reach.reach("DROP after selection keeps coherent older root");
+              }
+              await h.space.audit();
+              reach.reach("exact final root inventory");
+              old.release();
+              old = null;
+              p = await h.reopen();
+              expect(p.catalog.table(target)).toBeUndefined();
+              expect(p.statistics(target)).toBeNull();
+              await autocommit(p, (s) => s.table(kept).insert(batch(ints([salt])), null));
+              p.liveMemtable(kept, 1);
+              await p.quiesce();
+              await h.space.audit();
+              reach.reach("cold reopen and continued publication");
+            } finally {
+              resume();
+              old?.release();
+              await h.close();
+            }
+            expect(gov.usedBytes).toBe(0);
+            expect(gov.peakBytes).toBeLessThanOrEqual(32 << 20);
+            reach.reach("32MiB native zero final credits");
+          }
+        },
+      ),
+      {
+        seed,
+        numRuns: 12,
+        examples: [
+          [4, 0],
+          [8, -7],
+        ],
+      },
+    );
+    reach.assertReached();
+  },
+  120000,
+);
diff --git a/packages/core/src/next/write/statistics-ndv-staged.test.ts b/packages/core/src/next/write/statistics-ndv-staged.test.ts
