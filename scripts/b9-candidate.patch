@@ -0,0 +1,54 @@
+/** Shared SK1 body reader: no destination means validation without register allocation.
+ * Callers retain their layer's error type and the centrally registered codec gates. */
+import {
+  requireTag,
+  DURABLE_CODECS,
+  CONDITIONAL_FORMAT,
+  type FormatErrorType,
+} from "../durable-format.js";
+type SketchCheck = (condition: boolean, message: string) => void;
+const SKETCH_PRECISION = DURABLE_CODECS.sketchPrecision;
+const REGISTERS = 1 << SKETCH_PRECISION;
+export function checkedSketchForm(
+  bytes: Uint8Array,
+  check: SketchCheck,
+  failure: FormatErrorType,
+): number {
+  check(bytes.length >= 4 && bytes[0] === SKETCH_PRECISION, "Bad distinct sketch header");
+  const form = bytes[1] ?? 0;
+  requireTag(form, DURABLE_CODECS.sketchForm, "sketch form", failure);
+  return form;
+}
+/** Same checks whether copying registers or validating an unused hint. */
+export function readSketchRegisters(
+  bytes: Uint8Array,
+  form: number,
+  registers: Uint8Array | null,
+  check: SketchCheck,
+): void {
+  const count = (bytes[2] ?? 0) | ((bytes[3] ?? 0) << 8);
+  if (form === 0) {
+    check(count === REGISTERS && bytes.length === 4 + REGISTERS, "Bad dense sketch");
+    // Validate while copying: no second pass or additional buffer.
+    for (let index = 0; index < REGISTERS; index++) {
+      const value = bytes[4 + index] ?? 0;
+      check(value <= CONDITIONAL_FORMAT.sketchMaximumRank, "Bad dense sketch rank");
+      if (registers !== null) registers[index] = value;
+    }
+  } else {
+    check(form === 1 && bytes.length === 4 + count * 3, "Bad sparse sketch");
+    let previous = -1;
+    for (let k = 0; k < count; k++) {
+      const at = 4 + k * 3;
+      const index = (bytes[at] ?? 0) | ((bytes[at + 1] ?? 0) << 8);
+      const value = bytes[at + 2] ?? 0;
+      check(
+        index < REGISTERS && value > 0 && value <= CONDITIONAL_FORMAT.sketchMaximumRank,
+        "Bad sketch entry",
+      );
+      check(index > previous, "Sparse sketch registers are not strictly increasing");
+      previous = index;
+      if (registers !== null) registers[index] = value;
+    }
+  }
+}
