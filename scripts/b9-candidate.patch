+/** B2-approved MST2 advice: compatible p10 register unions, never exact certificates.
+ * Encoded leases own their buffers; merging never mutates either input generation. */
+import { DURABLE_CODECS } from "../durable-format.js";
+import { OBJECT_OVERHEAD_BYTES } from "../memory/governor.js";
+import { checkedSketchForm, readSketchRegisters } from "./sketch-registers.js";
+import { valid, ManifestCorruptionError } from "./bytes.js";
+import type { PhysicalType } from "../types.js";
+import type { ByteBudget } from "../storage/extents.js";
+
+/** B2-approved, centrally registered hash revisions. */
+export const NDV_DOMAINS = DURABLE_CODECS.ndvDomain;
+export interface EncodedNdv {
+  readonly domain: number;
+  readonly scale: number | null;
+  readonly bytes: Uint8Array;
+  /** Non-durable, bounded by the owning generation. */
+  estimate?: number;
+}
+export function ndvDomain(type: PhysicalType): { domain: number; scale: number | null } | null {
+  if (type.kind === "decimal")
+    return type.scale !== null &&
+      Number.isInteger(type.scale) &&
+      type.scale >= 0 &&
+      type.scale <= 16383
+      ? { domain: NDV_DOMAINS.fixedNumeric, scale: type.scale }
+      : null;
+  switch (type.kind) {
+    case "bool":
+    case "int32":
+    case "int64":
+    case "float32":
+    case "float64":
+    case "date":
+    case "time":
+    case "timestamp":
+    case "text":
+    case "bytes":
+    case "uuid":
+    case "enum":
+    case "interval":
+      return { domain: NDV_DOMAINS[type.kind], scale: null };
+    default:
+      return null;
+  }
+}
+export function validateNdv(value: EncodedNdv): void {
+  if (!Number.isInteger(value.domain) || value.domain < 1 || value.domain > 14)
+    throw new RangeError("Unknown NDV hash domain");
+  if (value.domain === NDV_DOMAINS.fixedNumeric) {
+    if (
+      value.scale === null ||
+      !Number.isInteger(value.scale) ||
+      value.scale < 0 ||
+      value.scale > 16383
+    )
+      throw new RangeError("Invalid NDV numeric scale");
+  } else if (value.scale !== null) throw new RangeError("Non-numeric NDV carries a scale");
+  readSketchRegisters(
+    value.bytes,
+    checkedSketchForm(value.bytes, valid, ManifestCorruptionError),
+    null,
+    valid,
+  );
+}
+export function compatibleNdv(value: EncodedNdv, type: PhysicalType): boolean {
+  const domain = ndvDomain(type);
+  return domain !== null && value.domain === domain.domain && value.scale === domain.scale;
+}
+/** Metadata body is already validated. No register expansion or temporary array. */
+export function estimateNdv(value: EncodedNdv): number {
+  if (value.estimate !== undefined) return value.estimate;
+  const bytes = value.bytes,
+    count = (bytes[2] ?? 0) | ((bytes[3] ?? 0) << 8);
+  let sum = 0,
+    zeros = 0;
+  if (bytes[1] === 0) {
+    for (let i = 0; i < 1024; i++) {
+      const rank = bytes[4 + i] ?? 0;
+      sum += 2 ** -rank;
+      if (rank === 0) zeros++;
+    }
+  } else {
+    zeros = 1024 - count;
+    sum = zeros;
+    for (let k = 0; k < count; k++) sum += 2 ** -(bytes[6 + 3 * k] ?? 0);
+  }
+  const raw = ((0.7213 / (1 + 1.079 / 1024)) * 1024 * 1024) / sum;
+  return (value.estimate = raw <= 2.5 * 1024 && zeros > 0 ? 1024 * Math.log(1024 / zeros) : raw);
+}
+/** A caller must retain a lease while borrowing its value, including across awaits. */
+export class NdvLease {
+  #refs = 1;
+  #value: EncodedNdv | null;
+  constructor(
+    value: EncodedNdv,
+    readonly budget: ByteBudget,
+    readonly charge: number,
+  ) {
+    this.#value = value;
+  }
+  get value(): EncodedNdv {
+    if (this.#value === null) throw new Error("NDV lease is released");
+    return this.#value;
+  }
+  retain(): this {
+    if (this.#value === null) throw new Error("NDV lease is released");
+    this.#refs++;
+    return this;
+  }
+  release(): void {
+    if (this.#value === null) return;
+    if (--this.#refs > 0) return;
+    this.#value = null;
+    this.budget.free(this.charge);
+  }
+}
+/** MetadataBudget has a nonthrowing optional path; ordinary ByteBudget allocation
+ * already returns false. Advice never turns recoverable metadata pressure into a wait. */
+export function allocateAdvice(budget: ByteBudget, bytes: number): boolean {
+  const optional = budget as ByteBudget & { tryAllocate?: (bytes: number) => boolean };
+  return optional.tryAllocate ? optional.tryAllocate(bytes) : budget.allocate(bytes);
+}
+
+/** Optional copy: funding denial never changes the input or starts a wait. */
+export function ownNdv(value: EncodedNdv, budget: ByteBudget): NdvLease | null {
+  validateNdv(value);
+  const charge = value.bytes.length + 4 * OBJECT_OVERHEAD_BYTES;
+  if (!allocateAdvice(budget, charge)) return null;
+  try {
+    return new NdvLease(
+      { domain: value.domain, scale: value.scale, bytes: new Uint8Array(value.bytes) },
+      budget,
+      charge,
+    );
+  } catch (error) {
+    budget.free(charge);
+    throw error;
+  }
+}
+function mergeInto(registers: Uint8Array, bytes: Uint8Array): void {
+  if (bytes[1] === 0) {
+    for (let i = 0; i < 1024; i++) {
+      const rank = bytes[4 + i] ?? 0;
+      if (rank > (registers[i] ?? 0)) registers[i] = rank;
+    }
+  } else {
+    const count = (bytes[2] ?? 0) | ((bytes[3] ?? 0) << 8);
+    for (let k = 0; k < count; k++) {
+      const at = 4 + 3 * k,
+        index = (bytes[at] ?? 0) | ((bytes[at + 1] ?? 0) << 8),
+        rank = bytes[at + 2] ?? 0;
+      if (rank > (registers[index] ?? 0)) registers[index] = rank;
+    }
+  }
+}
+/** Exact register-max union. Unknown/incompatible coverage stays unknown. */
+export function mergeNdv(left: EncodedNdv, right: EncodedNdv, budget: ByteBudget): NdvLease | null {
+  validateNdv(left);
+  validateNdv(right);
+  if (left.domain !== right.domain || left.scale !== right.scale) return null;
+  const reserved = 1024 + 1028 + 8 * OBJECT_OVERHEAD_BYTES;
+  if (!allocateAdvice(budget, reserved)) return null;
+  let held = reserved;
+  try {
+    const registers = new Uint8Array(1024);
+    mergeInto(registers, left.bytes);
+    mergeInto(registers, right.bytes);
+    let count = 0;
+    for (let i = 0; i < 1024; i++) if ((registers[i] ?? 0) !== 0) count++;
+    const sparse = count * 3 < 1024,
+      bytes = new Uint8Array(sparse ? 4 + 3 * count : 1028);
+    bytes[0] = 10;
+    bytes[1] = sparse ? 1 : 0;
+    const n = sparse ? count : 1024;
+    bytes[2] = n & 255;
+    bytes[3] = n >>> 8;
+    if (sparse) {
+      let at = 4;
+      for (let i = 0; i < 1024; i++) {
+        const rank = registers[i] ?? 0;
+        if (rank === 0) continue;
+        bytes[at++] = i & 255;
+        bytes[at++] = i >>> 8;
+        bytes[at++] = rank;
+      }
+    } else bytes.set(registers, 4);
+    const retained = bytes.length + 4 * OBJECT_OVERHEAD_BYTES,
+      lease = new NdvLease({ domain: left.domain, scale: left.scale, bytes }, budget, retained);
+    budget.free(held - retained);
+    held = 0;
+    return lease;
+  } finally {
+    if (held) budget.free(held);
+  }
+}
