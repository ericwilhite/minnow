index 00000000..e5a449bf
--- /dev/null
+++ b/packages/core/src/next/write/statistics-owner.ts
@@ -0,0 +1,148 @@
+/** Publication ownership for persisted advisory statistics, separate from row state. */
+import type { ColumnTotals, TableStatistics } from "../format/manifest.js";
+import {
+  encodeTableStatistics,
+  decodeTableStatistics,
+  tableStatisticsEncodingCharge,
+  ParseBudgetError,
+  type Parsed,
+} from "../format/manifest-codec.js";
+import { ndvDomain, ownNdv, mergeNdv, allocateAdvice, type NdvLease } from "../format/ndv.js";
+import type { PhysicalType } from "../types.js";
+import type { ByteBudget } from "../storage/extents.js";
+
+/** The decoder charged its complete encoded/object footprint before allocating it.
+ * Creation owns one reference until a published write state retains this generation. */
+export class StatisticsGeneration {
+  #refs = 1;
+  #creation = true;
+  readonly columns: Map<number, ColumnTotals>;
+  readonly charge: number;
+  private constructor(
+    parsed: Parsed<TableStatistics>,
+    readonly budget: ByteBudget,
+  ) {
+    this.charge = parsed.charge;
+    this.columns = new Map(parsed.value.columns.map((column) => [column.columnId, column]));
+  }
+  static take(parsed: Parsed<TableStatistics>, budget: ByteBudget): StatisticsGeneration {
+    try {
+      return new StatisticsGeneration(parsed, budget);
+    } catch (error) {
+      budget.free(parsed.charge);
+      throw error;
+    }
+  }
+  retain(): void {
+    if (this.#refs === 0) throw new Error("Statistics generation is released");
+    this.#refs++;
+  }
+  release(): void {
+    if (this.#refs === 0) return;
+    if (--this.#refs !== 0) return;
+    this.columns.clear();
+    this.budget.free(this.charge);
+  }
+  releaseCreation(): void {
+    if (!this.#creation) return;
+    this.#creation = false;
+    this.release();
+  }
+}
+
+/** Optional immutable encoded output from a single new group. No borrowed page survives offer. */
+export class GroupNdvDelta {
+  readonly #columns = new Map<number, NdvLease | null>();
+  #closed = false;
+  private constructor(
+    readonly budget: ByteBudget,
+    readonly charge: number,
+  ) {}
+  static create(columns: number, budget: ByteBudget): GroupNdvDelta | null {
+    const charge = 512 + columns * 128;
+    if (!allocateAdvice(budget, charge)) return null;
+    try {
+      return new GroupNdvDelta(budget, charge);
+    } catch (error) {
+      budget.free(charge);
+      throw error;
+    }
+  }
+  get closed(): boolean {
+    return this.#closed;
+  }
+  offer(columnId: number, type: PhysicalType, bytes: Uint8Array): void {
+    if (this.#closed) throw new Error("Group statistics delta is released");
+    const old = this.#columns.get(columnId);
+    if (old === null) return;
+    const domain = ndvDomain(type);
+    if (domain === null) {
+      old?.release();
+      this.#columns.set(columnId, null);
+      return;
+    }
+    const value = { ...domain, bytes },
+      next = old ? mergeNdv(old.value, value, this.budget) : ownNdv(value, this.budget);
+    this.#columns.set(columnId, next);
+    old?.release();
+  }
+  get(columnId: number): NdvLease | null {
+    return this.#closed ? null : (this.#columns.get(columnId) ?? null);
+  }
+  close(): void {
+    if (this.#closed) return;
+    this.#closed = true;
+    for (const lease of this.#columns.values()) lease?.release();
+    this.#columns.clear();
+    this.budget.free(this.charge);
+  }
+}
+
+/** Encoding scratch and an independent parsed generation coexist under charge.
+ * No encoded subview aliases the released writer/read buffer. */
+export interface StatisticsOutput {
+  readonly bytes: Uint8Array;
+  readonly generation: StatisticsGeneration;
+  releaseBytes(): void;
+  close(): void;
+}
+export function encodeStatistics(
+  statistics: TableStatistics,
+  budget: ByteBudget,
+): StatisticsOutput | null {
+  let held = tableStatisticsEncodingCharge(statistics);
+  if (!allocateAdvice(budget, held)) return null;
+  let generation: StatisticsGeneration | null = null;
+  try {
+    let bytes: Uint8Array | null = encodeTableStatistics(statistics);
+    const retained = bytes.length + 512;
+    budget.free(held - retained);
+    held = retained;
+    generation = StatisticsGeneration.take(decodeTableStatistics(bytes, budget), budget);
+    const owned = generation;
+    const release = () => {
+      bytes = null;
+      if (held) {
+        budget.free(held);
+        held = 0;
+      }
+    };
+    return {
+      get bytes() {
+        if (bytes === null) throw new Error("Encoded statistics are released");
+        return bytes;
+      },
+      generation: owned,
+      releaseBytes: release,
+      close() {
+        release();
+        owned.releaseCreation();
+      },
+    };
+  } catch (error) {
+    if (held) budget.free(held);
+    generation?.releaseCreation();
+    if (error instanceof ParseBudgetError) return null;
+    throw error;
+  }
+}
