+/** MST2 validates unused advice on ordinary native open, after storage verified its checksum.
+ * The native writer computes blob checksums over intentionally malformed test payloads. */
+import fc from "fast-check";
+import { expect, it } from "vitest";
+import { seedsFor } from "../../testing/seeds.js";
+import { createReach, B9_NDV_REFUSAL_REACH } from "../../testing/reach.js";
+import { ByteReader } from "../format/bytes.js";
+import { Harness, autocommit, batch, column, ints, INT, tableInput } from "./test-support.js";
+const modes = [
+  "flags",
+  "domain",
+  "precision",
+  "rank",
+  "duplicate",
+  "truncated",
+  "old magic",
+] as const;
+type Mode = (typeof modes)[number];
+function alter(bytes: Uint8Array, mode: Mode): Uint8Array {
+  const out = new Uint8Array(bytes),
+    reader = new ByteReader(out);
+  reader.u32();
+  reader.u8();
+  reader.uint();
+  reader.uint();
+  for (let i = 0; i < 4; i++) reader.uint();
+  const flags = reader.at;
+  expect(reader.u8() & 2).toBe(2);
+  for (let i = 0; i < 2; i++) {
+    const tag = reader.u8();
+    if (tag === 3) reader.f64();
+    else if (tag === 4 || tag === 5) reader.borrowedBytes();
+    else expect(tag).toBeLessThanOrEqual(2);
+  }
+  const domain = reader.at;
+  reader.u8();
+  reader.uint();
+  const body = reader.at;
+  expect(out[body + 1]).toBe(1);
+  if (mode === "flags") out[flags] = 0x82;
+  else if (mode === "domain") out[domain] = 15;
+  else if (mode === "precision") out[body] = 11;
+  else if (mode === "rank") out[body + 6] = 24;
+  else if (mode === "duplicate") {
+    out[body + 7] = out[body + 4] ?? 0;
+    out[body + 8] = out[body + 5] ?? 0;
+  } else if (mode === "old magic") out[3] = 0x31;
+  return mode === "truncated" ? out.subarray(0, out.length - 1) : out;
+}
+it.each(seedsFor("b9-ndv-refusal", [0xb9e01, 0xb9e02]))(
+  "ordinary open refuses malformed inline advice seed %i",
