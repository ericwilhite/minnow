+/** R25 and B2's MST2 ownership seam: provisional advice cannot attach after its table disappears.
+ * Pause after the keeper prepared the final list, then commit or roll back a real DROP. */
+import fc from "fast-check";
+import { expect, it } from "vitest";
+import { seedsFor } from "../../testing/seeds.js";
+import { createReach, B9_NDV_PUBLICATION_CUT_REACH } from "../../testing/reach.js";
+import { Governor } from "../memory/governor.js";
+import {
+  Harness,
+  autocommit,
+  batch,
+  column,
+  ints,
+  INT,
+  rowsOf,
+  rules,
+  tableInput,
+} from "./test-support.js";
+import { need } from "./bytes.js";
+it.each(seedsFor("b9-ndv-publication-cut", [0xb9e11, 0xb9e12]))(
+  "final prepared publication keeps advice owned across DROP seed %i",
+  async (seed) => {
+    const reach = createReach("B9 NDV final preparation", B9_NDV_PUBLICATION_CUT_REACH);
+    await fc.assert(
+      fc.asyncProperty(fc.integer({ min: 4, max: 12 }), fc.boolean(), async (width, rollback) => {
+        reach.beginHistory();
+        let armed = false,
+          t = 0;
+        let entered!: () => void, release!: () => void;
+        const at = new Promise<void>((r) => {
+            entered = r;
+          }),
+          gate = new Promise<void>((r) => {
+            release = r;
+          });
+        const h = new Harness("strict", "memory", width, undefined, { merges: { mode: "off" } }),
+          gov = new Governor(32 << 20);
+        Object.assign(h, { governor: gov });
+        h.extentDeltas = {
+          prepare: async (_attempt, delta) => {
+            if (armed && delta.writer.label === `flush t${String(t)}`) {
+              armed = false;
+              entered();
+              await gate;
+            }
+            return null;
+          },
+          commit: () => undefined,
+          abort: () => undefined,
+        };
+        let pin: ReturnType<Awaited<ReturnType<typeof h.open>>["pin"]> | null = null;
+        try {
+          let p = await h.open();
+          await autocommit(p, async (s) => {
+            t =
+              (
+                await s.changeCatalog({
+                  kind: "createTable",
+                  table: tableInput("cut", [column("id", INT, false)]),
+                })
+              ).id ?? 0;
+          });
+          const first = Array.from({ length: width }, (_, i) => i),
+            second = first.map((i) => i + width);
+          await autocommit(p, (s) => s.table(t).insert(batch(ints(first)), null));
+          p.liveMemtable(t, width);
+          await p.quiesce();
+          const old = need(p.state().tables.get(t)?.statistics),
+            hint = need(old.columns.values().next().value?.ndv),
+            saved = new Uint8Array(hint.bytes);
+          pin = p.pin();
+          armed = true;
+          await autocommit(p, (s) => s.table(t).insert(batch(ints(second)), null));
+          p.liveMemtable(t, width);
+          await at;
+          reach.reach("held after final keeper preparation");
+          const tx = await p.begin(),
+            statement = tx.statement({ rules });
+          await statement.changeCatalog({ kind: "dropTable", tableId: t });
+          await statement.end();
+          if (rollback) {
+            tx.rollback();
+            reach.reach("DROP rollback before publish");
+          } else {
+            await (
+              await tx.commit(null)
+            ).durable;
+            reach.reach("DROP commit before publish");
