+++ b/packages/core/src/next/write/statistics-ndv-staged.test.ts
@@ -0,0 +1,176 @@
+/** Optional staged sketch reads use only nonwaiting credit; a missing group makes coverage unknown. */
+import fc from "fast-check";
+import { expect, it, vi } from "vitest";
+import { seedsFor } from "../../testing/seeds.js";
+import { createReach, B9_NDV_STAGED_REACH } from "../../testing/reach.js";
+import { Governor } from "../memory/governor.js";
+import type { BlobRef } from "../storage/extents.js";
+import { MetadataBudget } from "./budget.js";
+import { groupRootOf } from "./memtable.js";
+import { need } from "./bytes.js";
+import {
+  Harness,
+  autocommit,
+  batch,
+  column,
+  ints,
+  texts,
+  rowsOf,
+  rules,
+  INT,
+  TEXT,
+  tableInput,
+} from "./test-support.js";
+
+it.each(seedsFor("b9-ndv-staged", [0xb9de1, 0xb9de2]))(
+  "staged advice omission stays nonwaiting and exact at32MiB seed %i",
+  async (seed) => {
+    const reach = createReach("B9 staged advice", B9_NDV_STAGED_REACH);
+    await fc.assert(
+      fc.asyncProperty(fc.integer({ min: 4, max: 7 }), fc.boolean(), async (parts, deny) => {
+        reach.beginHistory();
+        const h = new Harness("strict", "memory", 8, undefined, { merges: { mode: "off" } }),
+          governor = new Governor(32 << 20);
+        Object.assign(h, { governor });
+        const refs = new Set<string>();
+        let readingAdvice = false,
+          reads = 0,
+          denied = 0;
+        // eslint-disable-next-line @typescript-eslint/unbound-method -- Rebound to the intercepted metadata budget via call.
+        const optional = MetadataBudget.prototype.tryAllocate;
+        const spy = vi.spyOn(MetadataBudget.prototype, "tryAllocate").mockImplementation(function (
+          this: MetadataBudget,
+          bytes: number,
+        ) {
+          if (readingAdvice && deny) {
+            denied++;
+            return false;
+          }
+          return optional.call(this, bytes);
+        });
+        h.onSpace = (space) => {
+          const read = space.read.bind(space);
+          space.read = async (requested, options) => {
+            const advice = requested.some((ref) => refs.has(JSON.stringify(ref)));
+            if (advice) {
+              reads++;
+              readingAdvice = true;
+            }
+            try {
+              return await read(requested, options);
+            } finally {
+              if (advice) readingAdvice = false;
+            }
+          };
+        };
+        try {
+          const p = await h.open();
+          let t = 0;
+          await autocommit(p, async (s) => {
+            t =
+              (
+                await s.changeCatalog({
+                  kind: "createTable",
+                  table: tableInput("ndv_stage", [
+                    column("id", INT, false),
+                    column("n", INT),
+                    column("s", TEXT),
+                  ]),
+                })
+              ).id ?? 0;
+          });
+          const tx = await p.begin(),
+            expected: Array<[number, number | null, string | null]> = [];
+          for (let part = 0; part < parts; part++) {
+            const rows = Array.from({ length: 8 }, (_, i) => {
+              const id = part * 8 + i;
+              return [
+                id,
+                id % 11 === 0 ? null : id % 7,
+                id % 13 === 0 ? null : (["", "λ", "\ufeff", "s"][id % 4] ?? ""),
+              ] as const;
+            });
+            expected.push(...rows.map((row) => [...row] as [number, number | null, string | null]));
+            const s = tx.statement({ rules });
+            await s
+              .table(t)
+              .insert(
+                batch(
+                  ints(rows.map((r) => r[0])),
+                  ints(rows.map((r) => r[1])),
+                  texts(rows.map((r) => r[2])),
+                ),
+                null,
+              );
+            await s.end();
+          }
+          expect(p.maintenance.stages).toBeGreaterThan(0);
+          reach.reach("real staged transaction");
+          const state = need(p.state().tables.get(t));
+          const memtables = new Set(state.memtables);
+          for (const memtable of memtables) {
+            const part = memtable.staged;
+            if (!part) continue;
+            part.ndv?.close();
+            delete part.ndv;
+            const root = await groupRootOf(part.groupRoot);
+            for (const c of root.columns)
+              if (c.distinctSketch !== null)
+                refs.add(JSON.stringify(c.distinctSketch satisfies BlobRef));
+          }
+          expect(refs.size).toBeGreaterThan(0);
+          reach.reach("evicted optional staged cache");
+          await (
+            await tx.commit(null)
+          ).durable;
+          p.liveMemtable(t, 8);
+          await p.quiesce();
+          expect(reads).toBeGreaterThan(0);
+          reach.reach("reads only newly staged sketch refs");
+          const view = p.pin();
+          try {
+            expect((await rowsOf(view, t)).sort((a, b) => Number(a[0]) - Number(b[0]))).toEqual(
+              expected,
+            );
+          } finally {
+            view.release();
+          }
+          reach.reach("exact independent row model");
+          const n = need(p.catalog.table(t)).columns[1];
+          if (!n) throw Error("n column");
+          const estimate = p.statistics(t)?.column(n.id)?.distinct;
+          if (deny) {
+            expect(denied).toBeGreaterThan(0);
+            expect(estimate).toBeNull();
+            reach.reach("optional read credit denied without wait");
+            reach.reach("missing group coverage stays unknown");
+          } else {
+            expect(denied).toBe(0);
+            expect(typeof estimate).toBe("number");
+            if (typeof estimate !== "number") throw Error("funded staged NDV missing");
+            expect(Math.abs(estimate - 7)).toBeLessThan(2);
+            reach.reach("funded staged union estimate");
+          }
+        } finally {
+          spy.mockRestore();
+          h.onSpace = null;
+          await h.close();
+        }
+        expect(governor.usedBytes).toBe(0);
+        expect(governor.peakBytes).toBeLessThanOrEqual(governor.capBytes);
+        reach.reach("32MiB complete native owner");
+        reach.reach("zero final credits");
+      }),
+      {
+        seed,
+        numRuns: 12,
+        examples: [
+          [4, false],
+          [4, true],
+        ],
+      },
+    );
+    reach.assertReached();
+  },
+  120000,
+);
diff --git a/packages/core/src/next/write/statistics-ndv.test.ts b/packages/core/src/next/write/statistics-ndv.test.ts
