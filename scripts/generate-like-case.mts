/** Regenerate the pinned C.UTF-8 simple-lowercase semantic table from the PG authority. */
import { PGlite } from "@electric-sql/pglite";
import { writeFile } from "node:fs/promises";
import { createHash } from "node:crypto";
const pg = new PGlite();
try {
  await pg.waitReady;
  const { rows } = await pg.query<{ g: number; l: string }>(
    "SELECT g,lower(chr(g)) l FROM generate_series(1,1114111) g WHERE (g<55296 OR g>57343) AND lower(chr(g))<>chr(g)",
  );
  const pairs = rows.map((r) => [r.g, r.l.codePointAt(0) ?? 0]);
  if (rows.some((r) => [...r.l].length !== 1))
    throw new Error("PG no longer uses simple lowercase");
  const ranges: number[] = [];
  for (let i = 0; i < pairs.length;) {
    const a = pairs[i];
    if (!a) throw new Error("Missing case pair");
    let end = a[0] ?? 0,
      j = i + 1;
    const delta = (a[1] ?? 0) - end;
    const step = (pairs[j]?.[0] ?? end) - end;
    if (step === 1 || step === 2)
      while (
        j < pairs.length &&
        (pairs[j]?.[0] ?? 0) === end + step &&
        (pairs[j]?.[1] ?? 0) - (pairs[j]?.[0] ?? 0) === delta
      ) {
        end += step;
        j++;
      }
    ranges.push(a[0] ?? 0, end, j > i + 1 ? step : 1, delta);
    i = j;
  }
  const hash = createHash("sha256").update(JSON.stringify(pairs)).digest("hex");
  const code = `/** Generated by scripts/generate-like-case.mts from PGlite PostgreSQL C.UTF-8.\n * Immutable semantic data, not a query cache. Scalar pair SHA256 ${hash}.\n * Keep independent of host JS Unicode versions; Node22 and26 must agree. */\nconst CASE = new Int32Array(${JSON.stringify(ranges)});\n/** Default database ctype hook: C.UTF-8 simple lower; explicit C/POSIX is ASCII. */\nexport function likeLower(c:number, unicode:boolean):number {\n if(c>=65&&c<=90)return c+32;\n if(!unicode||c<128)return c;\n let lo=0,hi=CASE.length/4;\n while(lo<hi){const mid=(lo+hi)>>>1,b=mid*4,start=CASE[b]??0,end=CASE[b+1]??0;\n if(c<start)hi=mid;else if(c>end)lo=mid+1;else return (c-start)%(CASE[b+2]??1)===0?c+(CASE[b+3]??0):c;}\n return c;\n}\n`;
  const at = process.argv.indexOf("--output");
  await writeFile(
    at < 0
      ? new URL("../packages/core/src/next/exec/kernels/like-case.ts", import.meta.url)
      : (process.argv[at + 1] ?? ""),
    code,
  );
  console.log({ pairs: pairs.length, ranges: ranges.length / 4, hash });
} finally {
  await pg.close();
}
