+  let at = 0;
+  for (const part of parts) {
+    if (part.data.layout !== "varlen") throw new TypeError("Expected UTF-8 dictionary");
+    const from = part.data.offsets[0] ?? 0,
+      to = part.data.offsets[part.length] ?? from;
+    data.set(part.data.bytes.subarray(from, to), at);
+    at += to - from;
+  }
+  let id = ids.get(vector.dictionary);
+  if (id === undefined) {
+    id = newDictionaryId();
+    ids.set(vector.dictionary, id);
+  }
+  return {
+    form: "dictionary",
+    type,
+    length: vector.length,
+    validity: vector.validity,
+    codes: vector.codes,
+    dictionaryId: id,
+    dictionary: {
+      form: "flat",
+      type,
+      length,
+      validity: null,
+      data: { layout: "varlen", bytes: data, offsets },
+    },
+  };
+}
