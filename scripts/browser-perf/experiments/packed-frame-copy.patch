+++ b/packages/core/src/next/vector/frame.ts
@@ -0,0 +1,246 @@
+/** Native wire views shared by sender and receiver. No executor/runtime dependency.
+ * Packed frames own one fixed ArrayBuffer. Every subview is aligned, bounded, disjoint and
+ * points into that buffer. Legacy whole-buffer frames remain only for A/B/reference fixtures.
+ */
+import type { Validity, VectorData } from "./vector.js";
+export const STREAM_DICTIONARY_BYTES = 1024 * 1024;
+export type UnnumberedPayload = Omit<FramePayload, "sequence">;
+export interface WireFlat {
+  readonly form: "flat";
+  readonly length: number;
+  /** Bit set = valid; null when every slot is valid. */
+  readonly validity: Validity | null;
+  readonly data: VectorData;
+}
+
+export interface WireConstant {
+  readonly form: "constant";
+  readonly length: number;
+  /** Length 1. */
+  readonly value: WireFlat;
+}
+
+export interface WireDictionary {
+  readonly form: "dictionary";
+  readonly length: number;
+  /** Codes into stream dictionary `dictionary` (meaningful only where `validity` says valid). */
+  readonly codes: Int32Array;
+  readonly validity: Validity | null;
+  readonly dictionary: number;
+}
+
+export type WireVector = WireFlat | WireConstant | WireDictionary;
+
+/** Entries appended to stream dictionary `id` at index `from` (distinct, non-null). */
+export interface DictionaryDelta {
+  readonly id: number;
+  readonly from: number;
+  readonly values: WireFlat;
+}
+
+/** Plain data: structured-clone safe, no functions. */
+export interface FramePayload {
+  /** Packed candidate: one fresh frame-owned fixed buffer; absent for legacy comparison frames. */
+  readonly buffer?: ArrayBuffer;
+  /** 0, 1, 2… within the stream, so a protocol can detect a lost frame. */
+  readonly sequence: number;
+  readonly rowCount: number;
+  /** One per output column, each `length === rowCount`. */
+  readonly columns: readonly WireVector[];
+  /** Dictionary entries first needed by this frame, applied before its columns are read. */
+  readonly dictionaries: readonly DictionaryDelta[];
+}
+
+export class FrameBufferError extends Error {
+  readonly code = "MINNOW_FRAME_BUFFER";
+  constructor(message: string) {
+    super(message);
+    this.name = "FrameBufferError";
+  }
+}
+type TypedArray =
+  Uint8Array | Uint16Array | Uint32Array | Int32Array | Float32Array | Float64Array | BigInt64Array;
+
+function add(
+  into: TypedArray[],
+  value: TypedArray,
+  Type: { new (...args: never[]): TypedArray },
+): void {
+  if (!(value instanceof Type)) throw new FrameBufferError("Wrong frame view element type");
+  into.push(value);
+}
+function dataArrays(data: VectorData, into: TypedArray[]): void {
+  switch (data.layout) {
+    case "bool":
+      add(into, data.values, Uint8Array);
+      return;
+    case "i32":
+      add(into, data.values, Int32Array);
+      return;
+    case "f32":
+      add(into, data.values, Float32Array);
+      return;
+    case "f64":
+      add(into, data.values, Float64Array);
+      return;
+    case "int64":
+      add(into, data.values.values, data.values.repr === "safe" ? Float64Array : BigInt64Array);
+      return;
+    case "decimal": {
+      if (data.scales !== null) add(into, data.scales, Uint16Array);
+      if (data.specials !== null) add(into, data.specials, Uint8Array);
+      const coefficients = data.coefficients;
+      if (coefficients.repr === "int128") add(into, coefficients.limbs, Uint32Array);
+      else if (coefficients.repr !== "wide")
+        add(into, coefficients.values, coefficients.repr === "safe" ? Float64Array : BigInt64Array);
+      return;
+    }
+    case "varlen":
+      add(into, data.bytes, Uint8Array);
+      add(into, data.offsets, Int32Array);
+      return;
+    case "fixed16":
+      add(into, data.bytes, Uint8Array);
+      return;
+    case "interval":
+      add(into, data.months, Int32Array);
+      add(into, data.days, Int32Array);
+      add(into, data.micros.values, data.micros.repr === "safe" ? Float64Array : BigInt64Array);
+      return;
+  }
+}
+
+export function frameFlats(payload: UnnumberedPayload): WireFlat[] {
+  const out: WireFlat[] = payload.dictionaries.map((delta) => delta.values);
+  for (const column of payload.columns)
+    if (column.form === "flat") out.push(column);
+    else if (column.form === "constant") out.push(column.value);
+  return out;
+}
+
+export function payloadArrays(payload: UnnumberedPayload): TypedArray[] {
+  const arrays: TypedArray[] = [];
+  for (const flat of frameFlats(payload)) {
+    dataArrays(flat.data, arrays);
+    if (flat.validity !== null) add(arrays, flat.validity, Uint32Array);
+  }
+  for (const column of payload.columns)
+    if (column.form === "dictionary") {
+      add(arrays, column.codes, Int32Array);
+      if (column.validity !== null) add(arrays, column.validity, Uint32Array);
+    }
+  return arrays;
+}
+
+/**
+ * The distinct ArrayBuffers of a payload, for `postMessage`'s transfer list. Throws
+ * `FrameBufferError` if a view does not cover its whole buffer or the buffer is shared. Wide
+ * decimal coefficients (`bigint[]`) are structured-cloned, not transferred.
+ */
+function packedLengths(payload: UnnumberedPayload): void {
+  const requireLength = (view: { readonly length: number }, n: number) => {
+    if (view.length < n) throw new FrameBufferError("Packed view is shorter than its frame lane");
+  };
+  const flat = (f: WireFlat) => {
+    const n = f.length,
+      d = f.data;
+    if (!Number.isSafeInteger(n) || n < 0) throw new FrameBufferError("Invalid frame lane length");
+    if (f.validity !== null) requireLength(f.validity, Math.ceil(n / 32));
+    switch (d.layout) {
+      case "bool":
+      case "i32":
+      case "f32":
+      case "f64":
+        requireLength(d.values, n);
+        break;
+      case "int64":
+        requireLength(d.values.values, n);
+        break;
+      case "fixed16":
+        requireLength(d.bytes, 16 * n);
+        break;
+      case "interval":
+        requireLength(d.months, n);
+        requireLength(d.days, n);
+        requireLength(d.micros.values, n);
+        break;
+      case "decimal":
+        if (d.scales) requireLength(d.scales, n);
+        if (d.specials) requireLength(d.specials, n);
+        if (d.coefficients.repr === "int128") requireLength(d.coefficients.limbs, 4 * n);
+        else requireLength(d.coefficients.values, n);
+        break;
+      case "varlen": {
+        requireLength(d.offsets, n + 1);
+        const first = d.offsets[0] ?? -1,
+          last = d.offsets[n] ?? -1;
+        if (first < 0 || last < first || last > d.bytes.length)
+          throw new FrameBufferError("Packed varlen range is out of bounds");
+        break;
+      }
+    }
+  };
+  if (!Number.isSafeInteger(payload.rowCount) || payload.rowCount < 0)
+    throw new FrameBufferError("Invalid frame row count");
+  for (const column of payload.columns) {
+    if (column.length !== payload.rowCount)
+      throw new FrameBufferError("Frame lane row count mismatch");
+    if (column.form === "flat") flat(column);
+    else if (column.form === "constant") {
+      if (column.value.length !== 1)
+        throw new FrameBufferError("Constant frame lane must have one value");
+      flat(column.value);
+    } else {
+      requireLength(column.codes, column.length);
+      if (column.validity) requireLength(column.validity, Math.ceil(column.length / 32));
+    }
+  }
+  for (const delta of payload.dictionaries) flat(delta.values);
+}
+
+export function frameTransferList(payload: UnnumberedPayload): ArrayBuffer[] {
+  const arrays = payloadArrays(payload);
+  if (payload.buffer !== undefined) {
+    packedLengths(payload);
+    const buffer = payload.buffer;
+    if (
+      !(buffer instanceof ArrayBuffer) ||
+      (buffer as ArrayBuffer & { resizable?: boolean }).resizable
+    )
+      throw new FrameBufferError("Packed frame requires a fixed ArrayBuffer");
+    // Sort views, not byte intervals: native views cannot forge bounds/alignment. Check those
+    // explicitly as well; only a strict element-type check below can establish a valid view.
+    arrays.sort((a, b) => a.byteOffset - b.byteOffset);
+    let end = 0;
+    for (const view of arrays) {
+      if (
+        !ArrayBuffer.isView(view) ||
+        !(view.buffer instanceof ArrayBuffer) ||
+        view.buffer !== buffer
+      )
+        throw new FrameBufferError("Packed view belongs to a foreign buffer");
+      if (
+        view.byteOffset % view.BYTES_PER_ELEMENT !== 0 ||
+        view.byteOffset + view.byteLength > buffer.byteLength
+      )
+        throw new FrameBufferError("Packed view is misaligned or out of bounds");
+      if (view.byteLength === 0) continue;
+      if (view.byteOffset < end) throw new FrameBufferError("Packed views overlap");
+      end = view.byteOffset + view.byteLength;
+    }
+    return [buffer];
+  }
+  const buffers = new Set<ArrayBuffer>();
+  for (const view of arrays) {
+    const buffer = view.buffer;
+    if (!(buffer instanceof ArrayBuffer))
+      throw new FrameBufferError("Frame buffers must be ArrayBuffers, never SharedArrayBuffer");
+    if (buffers.has(buffer)) continue;
+    if (view.byteOffset !== 0 || view.byteLength !== buffer.byteLength)
+      throw new FrameBufferError(
+        `A frame view covers ${String(view.byteLength)} of its buffer's ${String(buffer.byteLength)} bytes`,
+      );
+    buffers.add(buffer);
+  }
+  return [...buffers];
+}
