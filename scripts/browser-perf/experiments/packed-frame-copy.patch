@@ -0,0 +1,119 @@
+/** Copy native frame lanes into one precharged, fresh frame-owned buffer. Float payload words
+ * are copied as bytes. No page/cache/dictionary/pool buffer becomes a transferable output.
+ */
+import type { Int64Values, VectorData } from "./vector.js";
+import {
+  payloadArrays,
+  frameTransferList,
+  type WireFlat,
+  type UnnumberedPayload,
+} from "./frame.js";
+type Native = ReturnType<typeof payloadArrays>[number];
+const align = (n: number, width: number) => Math.ceil(n / width) * width;
+export function packedFrameBytes(payload: UnnumberedPayload): number {
+  let bytes = 0;
+  for (const view of payloadArrays(payload))
+    bytes = align(bytes, view.BYTES_PER_ELEMENT) + view.byteLength;
+  return bytes;
+}
+export function packFrame<T extends UnnumberedPayload>(
+  payload: T,
+  buffer: ArrayBuffer,
+): T & { readonly buffer: ArrayBuffer } {
+  if (buffer.byteLength !== packedFrameBytes(payload))
+    throw new RangeError("Packed allocation size mismatch");
+  const copied = new Map<Native, Native[]>();
+  let cursor = 0;
+  for (const source of payloadArrays(payload)) {
+    cursor = align(cursor, source.BYTES_PER_ELEMENT);
+    const Type = source.constructor as {
+      new (buffer: ArrayBuffer, offset: number, length: number): Native;
+    };
+    const into = new Type(buffer, cursor, source.length);
+    new Uint8Array(buffer, cursor, source.byteLength).set(
+      new Uint8Array(source.buffer, source.byteOffset, source.byteLength),
+    );
+    const queue = copied.get(source) ?? [];
+    queue.push(into);
+    copied.set(source, queue);
+    cursor += source.byteLength;
+  }
+  const view = <V extends Native>(source: V): V => {
+    const next = copied.get(source)?.shift();
+    if (!next) throw new Error("Missing packed view");
+    return next as V;
+  };
+  const ints = (n: Int64Values): Int64Values =>
+    n.repr === "safe" ? { ...n, values: view(n.values) } : { ...n, values: view(n.values) };
+  const data = (d: VectorData): VectorData => {
+    switch (d.layout) {
+      case "bool":
+        return { ...d, values: view(d.values) };
+      case "i32":
+        return { ...d, values: view(d.values) };
+      case "f32":
+        return { ...d, values: view(d.values) };
+      case "f64":
+        return { ...d, values: view(d.values) };
+      case "varlen":
+        return { ...d, bytes: view(d.bytes), offsets: view(d.offsets) };
+      case "fixed16":
+        return { ...d, bytes: view(d.bytes) };
+      case "int64":
+        return { ...d, values: ints(d.values) };
+      case "interval":
+        return {
+          ...d,
+          months: view(d.months),
+          days: view(d.days),
+          micros: ints(d.micros),
+        };
+      case "decimal":
+        return {
+          ...d,
+          scales: d.scales === null ? null : view(d.scales),
+          specials: d.specials === null ? null : view(d.specials),
+          coefficients:
+            d.coefficients.repr === "int128"
+              ? { ...d.coefficients, limbs: view(d.coefficients.limbs) }
+              : d.coefficients.repr === "wide"
+                ? d.coefficients
+                : ints(d.coefficients),
+        };
+    }
+  };
+  const flat = (f: WireFlat): WireFlat => ({
+    ...f,
+    validity: f.validity === null ? null : view(f.validity),
+    data: data(f.data),
+  });
+  const packed = {
+    ...payload,
+    buffer,
+    dictionaries: payload.dictionaries.map((delta) => ({ ...delta, values: flat(delta.values) })),
+    columns: payload.columns.map((c) =>
+      c.form === "flat"
+        ? flat(c)
+        : c.form === "constant"
+          ? { ...c, value: flat(c.value) }
+          : { ...c, codes: view(c.codes), validity: c.validity === null ? null : view(c.validity) },
+    ),
+  };
+  frameTransferList(packed);
+  return packed as T & { readonly buffer: ArrayBuffer };
+}
+/** Compact dictionary storage survives the containing packed frame without retaining it. */
+export function copyDictionary(source: WireFlat): WireFlat {
+  if (source.data.layout !== "varlen") throw new TypeError("Stream dictionary must contain UTF-8");
+  const d = source.data,
+    base = d.offsets[0] ?? 0;
+  return {
+    ...source,
+    validity: source.validity?.slice() ?? null,
+    data: {
+      layout: "varlen",
+      bytes: d.bytes.slice(base, d.offsets[source.length] ?? base),
+      offsets: Int32Array.from(d.offsets.subarray(0, source.length + 1), (n) => n - base),
+    },
+  };
+}
