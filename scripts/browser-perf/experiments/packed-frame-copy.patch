+
+/** Keep wire dictionary/constant semantics in the oracle adapter as in the real client. */
+function frameVector(
+  vector: WireVector,
+  type: PhysicalType,
+  dictionaries: StreamDictionaries,
+  ids: Map<number, number>,
+): Batch["columns"][number] {
+  if (vector.form === "flat") return { ...vector, type };
