index 00000000..443138da
--- /dev/null
+++ b/packages/core/src/next/exec/frame-memory.ts
@@ -0,0 +1,55 @@
+/** Reserve both raw frame buffers and their packed destination before either allocation. One
+ * progress loan therefore covers a bounded copy/pack step; sealing never asks for another loan.
+ * The dedicated source's existing reclassification reservation pays for its packed copy instead.
+ */
+import { bigintBytes, type Grant } from "../memory/governor.js";
+import { frameFlats, type UnnumberedPayload } from "../vector/frame.js";
+import { packedFrameBytes, packFrame } from "../vector/pack-frame.js";
+export class FrameMemory {
+  #used = 0;
+  #packed = false;
+  #closed = false;
+  #padded = false;
+  constructor(
+    readonly grant: Grant,
+    readonly padding: number,
+  ) {}
+  allocate(n: number): boolean {
+    return this.reserve(2 * n);
+  }
+  free(n: number): void {
+    if (this.#packed || this.#closed) return;
+    this.#used -= 2 * n;
+    this.grant.free(2 * n);
+  }
+  reserve(n: number): boolean {
+    if (!this.grant.allocate(n)) return false;
+    this.#used += n;
+    return true;
+  }
+  prepayPadding(): boolean {
+    if (this.#padded) return true;
+    return (this.#padded = this.reserve(this.padding));
+  }
+  pack(payload: UnnumberedPayload, closeRaw: () => void): UnnumberedPayload {
+    const bytes = packedFrameBytes(payload);
+    let wide = 0;
+    for (const flat of frameFlats(payload))
+      if (flat.data.layout === "decimal" && flat.data.coefficients.repr === "wide")
+        for (const value of flat.data.coefficients.values) wide += bigintBytes(value);
+    if (bytes + wide > this.#used)
+      throw new Error("Packed buffer was not reserved before allocation");
+    const packed = packFrame(payload, new ArrayBuffer(bytes));
+    this.#packed = true;
+    closeRaw();
+    this.grant.free(this.#used - bytes - wide);
+    this.#used = bytes + wide;
+    return packed;
+  }
+  close(): void {
+    if (this.#closed) return;
+    this.#closed = true;
+    this.grant.free(this.#used);
+    this.#used = 0;
+  }
+}
