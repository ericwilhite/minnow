{
  "name": "@minnowdb/devtools",
  "version": "0.3.0",
  "description": "An embeddable SQL console and data browser for a Minnow database.",
  "license": "MIT",
  "author": "Eric Wilhite",
  "homepage": "https://minnowdb.com/docs/devtools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericwilhite/minnow.git",
    "directory": "packages/devtools"
  },
  "bugs": "https://github.com/ericwilhite/minnow/issues",
  "keywords": [
    "sql",
    "database",
    "browser",
    "devtools",
    "console",
    "minnow"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@minnowdb/core": ">=0.7.9 <1.0.0"
  }
}
