{
  "name": "@minnowdb/client",
  "version": "0.1.0",
  "description": "Typed query client for Minnow: a schema-aware builder over @minnowdb/core with inferred row types, constraints, views, and live queries.",
  "license": "MIT",
  "author": "Eric Wilhite",
  "homepage": "https://minnowdb.com/docs/client/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericwilhite/minnow.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/ericwilhite/minnow/issues",
  "keywords": [
    "sql",
    "database",
    "browser",
    "typescript",
    "query-builder",
    "minnow"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/*.tsbuildinfo"
  ],
  "dependencies": {
    "@minnowdb/core": ">=0.1.0 <1.0.0"
  }
}
