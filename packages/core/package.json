{
  "name": "@minnowdb/core",
  "version": "0.7.3",
  "description": "A columnar SQL database for the browser: PostgreSQL-style SQL over durable IndexedDB or OPFS data, with no server or WebAssembly module.",
  "license": "MIT",
  "author": "Eric Wilhite",
  "homepage": "https://minnowdb.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericwilhite/minnow.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/ericwilhite/minnow/issues",
  "keywords": [
    "sql",
    "database",
    "browser",
    "indexeddb",
    "opfs",
    "columnar",
    "olap",
    "in-browser",
    "offline-first",
    "full-text-search",
    "query-engine"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/engine/worker.js",
    "./dist/engine/worker-indexeddb.js",
    "./dist/engine/worker-opfs.js",
    "./dist/engine/worker-memory.js"
  ],
  "scripts": {
    "prepack": "node ../../scripts/strip-dist-comments.mjs dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plan": {
      "types": "./dist/plan/index.d.ts",
      "default": "./dist/plan/index.js"
    },
    "./client": {
      "types": "./dist/engine/client.d.ts",
      "default": "./dist/engine/client.js"
    },
    "./query": {
      "types": "./dist/engine/query-api.d.ts",
      "default": "./dist/engine/query-api.js"
    },
    "./live": {
      "types": "./dist/engine/live-api.d.ts",
      "default": "./dist/engine/live-api.js"
    },
    "./schema": {
      "types": "./dist/engine/schema.d.ts",
      "default": "./dist/engine/schema.js"
    },
    "./schema-wire": {
      "types": "./dist/engine/schema-wire.d.ts",
      "default": "./dist/engine/schema-wire.js"
    },
    "./worker": {
      "types": "./dist/engine/worker.d.ts",
      "default": "./dist/engine/worker.js"
    },
    "./worker/indexeddb": {
      "types": "./dist/engine/worker-indexeddb.d.ts",
      "default": "./dist/engine/worker-indexeddb.js"
    },
    "./worker/opfs": {
      "types": "./dist/engine/worker-opfs.d.ts",
      "default": "./dist/engine/worker-opfs.js"
    },
    "./worker/memory": {
      "types": "./dist/engine/worker-memory.d.ts",
      "default": "./dist/engine/worker-memory.js"
    },
    "./worker-host": {
      "types": "./dist/engine/worker-host.d.ts",
      "default": "./dist/engine/worker-host.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./storage/contracts": {
      "types": "./dist/storage/types.d.ts",
      "default": "./dist/storage/types.js"
    },
    "./storage/snapshots": {
      "types": "./dist/storage/snapshot.d.ts",
      "default": "./dist/storage/snapshot.js"
    },
    "./storage/indexeddb": {
      "types": "./dist/storage/indexeddb.d.ts",
      "default": "./dist/storage/indexeddb.js"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "default": "./dist/storage/memory.js"
    },
    "./storage/opfs": {
      "types": "./dist/storage/opfs/index.d.ts",
      "default": "./dist/storage/opfs/index.js"
    },
    "./storage/persistence": {
      "types": "./dist/storage/persistence.d.ts",
      "default": "./dist/storage/persistence.js"
    },
    "./storage/toolkit": {
      "types": "./dist/storage/toolkit/index.d.ts",
      "default": "./dist/storage/toolkit/index.js"
    },
    "./block-format": {
      "types": "./dist/block-format/index.d.ts",
      "default": "./dist/block-format/index.js"
    },
    "./transactions": {
      "types": "./dist/transactions/index.d.ts",
      "default": "./dist/transactions/index.js"
    },
    "./worker-protocol": {
      "types": "./dist/worker-protocol/index.d.ts",
      "default": "./dist/worker-protocol/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./postgres-feature-profile.json": "./postgres-feature-profile.json",
    "./sql-feature-matrix.json": "./sql-feature-matrix.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.map",
    "!dist/storage/fixture-shape.*",
    "!dist/engine/storage-test-helpers.*",
    "!dist/testing/seeds.*",
    "!dist/testing/oracle.*",
    "!dist/*.tsbuildinfo",
    "sql-feature-matrix.json",
    "postgres-feature-profile.json"
  ]
}
