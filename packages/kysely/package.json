{
  "name": "@minnowdb/kysely",
  "version": "0.4.5",
  "description": "Run Kysely queries against Minnow's browser-local SQL engine.",
  "license": "MIT",
  "author": "Eric Wilhite",
  "homepage": "https://minnowdb.com/docs/adapters/kysely/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericwilhite/minnow.git",
    "directory": "packages/kysely"
  },
  "bugs": "https://github.com/ericwilhite/minnow/issues",
  "keywords": [
    "sql",
    "database",
    "browser",
    "kysely",
    "query-builder",
    "minnow"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo"
  ],
  "dependencies": {
    "@minnowdb/core": ">=0.6.6 <1.0.0"
  },
  "peerDependencies": {
    "kysely": ">=0.29.5 <0.30.0"
  },
  "devDependencies": {
    "kysely": "^0.29.5"
  }
}
