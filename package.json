{
  "name": "browserdatabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @browserdatabase/bench",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && vitest run",
    "test:browser": "npm run build && playwright test",
    "test:library-browser": "tsc -b packages/storage-idb packages/testing packages/transactions packages/engine && playwright test --config playwright.library.config.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run format && npm run typecheck && npm run lint && npm test",
    "check:release": "npm run check && npm run test:library-browser && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^26.2.0",
    "eslint": "^9.32.0",
    "fake-indexeddb": "^6.1.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
