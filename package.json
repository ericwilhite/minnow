{
  "name": "minnow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @minnowdb/bench",
    "site:dev": "npm run dev --workspace @minnowdb/site",
    "site:build": "tsc -b packages/core && npm run build --workspace @minnowdb/site",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && vitest run",
    "test:browser": "npm run build && playwright test",
    "test:library-browser": "tsc -b packages/core && playwright test --config playwright.library.config.ts",
    "test:site": "tsc -b packages/core && playwright test --config playwright.site.config.ts",
    "capture": "tsc -b && playwright test --config apps/bench/capture/playwright.config.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run format && npm run typecheck && npm run lint && npm test",
    "check:release": "npm run check && npm run test:perf && npm run test:library-browser && npm run test:site && npm run test:browser",
    "test:perf": "vite-node scripts/perf-gate.mts"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
